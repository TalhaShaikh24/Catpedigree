@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <!--====== Required meta tags ======-->
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <!--====== Title ======-->
    <title>@ViewData["Title"] - Forgot Password</title>
    <!--====== Favicon Icon ======-->
    <link rel="shortcut icon" href="~/webassets/images/favicon.ico" type="image/png">
    <!--====== Bootstrap css ======-->
    <link rel="stylesheet" href="~/webassets/css/bootstrap.min.css">
    <!--====== FontAwesoem css ======-->
    <link rel="stylesheet" href="~/webassets/fonts/themify-icons/themify-icons.css">

    <!--====== Jquery ui css ======-->
    <link rel="stylesheet" href="~/webassets/css/jquery-ui.min.css">
    <!--====== Animate css ======-->
    <link rel="stylesheet" href="~/webassets/css/animate.css">
    <!--====== Default css ======-->
    <link rel="stylesheet" href="~/webassets/css/default.css">
    <!--====== Style css ======-->
    <link rel="stylesheet" href="~/webassets/css/style.css">
    <!--====== SweetAlert css ======-->
    <link rel="stylesheet" href="~/webassets/css/sweetalert2.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .password-container {
            position: relative;
            width: 100%;
        }

            .password-container input {
                width: 100%;
                padding-right: 40px; /* Adjust this based on the icon size */
            }

            .password-container i {
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
                cursor: pointer;
            }
    </style>
</head>
<body>
    <!--====== Start Preloader ======-->
    <div class="preloader" style="display:none">
        <div class="loader">
            <img src="~/webassets/images/loader.png" alt="loader">
        </div>
    </div>
    <!--====== End Preloader ======-->
    <!--====== Start Add Listing Section ======-->
    <section class="fioxen-add-listing pt-120 pb-120">
        <div class="container">
            <form>
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="add-listing-form general-listing-form mb-60 wow fadeInUp" id="forgotPasswordDiv">
                            <h4 class="title">Forgot Password</h4>
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form_group">
                                        <input type="text" id="email" class="form_control" placeholder="Enter your email address" name="email" required>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="button text-center">
                                        <button class="main-btn icon-btn" id="btn_forgotPassword" type="button">Submit</button>
                                    </div>
                                </div>
                                <div class="col-lg-12 mt-3">
                                    <div class="button text-center">
                                        <a style="color:#ef314c" href="/Home/Login">Login now</a>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="add-listing-form general-listing-form mb-60 wow fadeInUp" id="resetPasswordDiv" style="display: none;">
                            <h4 class="title">Reset Password</h4>
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form_group password-container">
                                        <input type="password" id="verificationCode" class="form_control" placeholder="Enter verification code" name="verificationCode" required>
                                        <i class="fa fa-eye" id="togglePassword1"></i>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="form_group password-container">
                                        <input type="password" id="newPassword" class="form_control" placeholder="Enter new password" name="newPassword" required>
                                        <i class="fa fa-eye" id="togglePassword2"></i>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="form_group password-container">
                                        <input type="password" id="confirmPassword" class="form_control" placeholder="Confirm new password" name="confirmPassword" required>
                                        <i class="fa fa-eye" id="togglePassword3"></i>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="button text-center">
                                        <button class="main-btn icon-btn" id="btn_resetPassword" type="button">Reset Password</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </form>
        </div>

        

    </section><!--====== End Add Listing Section ======-->
    <!--====== Jquery js ======-->
    <script src="~/webassets/js/vendor/jquery-3.6.0.min.js"></script>
    <!--====== Popper js ======-->
    <script src="~/webassets/js/popper.min.js"></script>
    <!--====== Bootstrap js ======-->
    <script src="~/webassets/js/bootstrap.min.js"></script>
    <!--====== SweetAlerts js ======-->
    <script src="~/webassets/js/sweetalert2.min.js"></script>
	<script src="~/webassets/pagesjs/forgotpassword.js"></script>
</body>
</html>


