<!-- Accordion section -->
<section class="Myaccordion py-5 ">
    <div class="container">
        <h2 class="text-center lines" style="color: #ED334F;">FAQ</h2>
        <p class="text-center pb-3 pt-1">If you can´t find the answer you´re looking for, just contact us via chat or by <a href="@Url.Action("Contact","Home")" style=" color: rgba(2, 112, 224, 1.0);">clicking here</a></p>
        <div class="row">
            <div class="col-12">
                <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingTwo">
                            <h4 class="panel-title">
                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                                   href="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                    Is VAT included in the price?
                                </a>
                            </h4>
                        </div>
                        <div id="collapseTwo" class="panel-collapse collapse" role="tabpanel"
                             aria-labelledby="headingTwo">
                            <div class="panel-body">
                                <p>For all our products and services VAT will be calculated and added during checkout.  </p>
                            </div>
                        </div>
                    </div>
                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingOne">
                            <h4 class="panel-title">
                                <a role="button" data-toggle="collapse" data-parent="#accordion" href="#collapseOne"
                                   aria-expanded="true" aria-controls="collapseOne">
                                    Is it possible to upgrade my Mediation package?
                                </a>
                            </h4>
                        </div>
                        <div id="collapseOne" class="panel-collapse collapse in" role="tabpanel"
                             aria-labelledby="headingOne">
                            <div class="panel-body">
                                <p>
                                    Absolutely! You will only need to pay the price difference between your current package and the new one. Rest assured, any costs already paid for successfully mediated kittens will not be deducted.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingThree">
                            <h4 class="panel-title">
                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                                   href="#collapseThree" aria-expanded="false" aria-controls="collapseThree">

                                    Can I trust that the breeders advertising on the website care for their cats?

                                </a>
                            </h4>
                        </div>
                        <div id="collapseThree" class="panel-collapse collapse" role="tabpanel"
                             aria-labelledby="headingThree">
                            <div class="panel-body">
                                <p>Here at Catpedigreeworld, we strive to ensure the well-being of all animals. We regularly review breeders' licenses and value feedback from those who have purchased a kitten through our website. If you have any concerns about a breeder listed on our site, please don't hesitate to reach out so we can investigate further. <a href="@Url.Action("Contact","Home")" style="font-weight: bold;color: red;">Click here to reach out to us.</a></p>
                            </div>
                        </div>
                    </div>

                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingThree">
                            <h4 class="panel-title">
                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                                   href="#collapsefour" aria-expanded="false" aria-controls="collapsefour">

                                    I´m just looking for a kitten, it doesn´t have to be a pedigree cat.

                                </a>
                            </h4>
                        </div>
                        <div id="collapsefour" class="panel-collapse collapse" role="tabpanel"
                             aria-labelledby="headingfour">
                            <div class="panel-body">
                                <p>We're sorry, but in these situations, Catpedigreeworld is not able to assist you. We recommend reaching out to a local animal shelter, as they often have information on non-pedigree kittens available in your area.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Accordion section end -->