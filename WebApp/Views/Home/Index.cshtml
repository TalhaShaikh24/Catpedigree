@{
    ViewData["Title"] = "Home Page";
}

<style>
    .blog-post-item-three .post-thumbnail img{
        object-fit: cover;
        width: 370px;
        height: 250px;
    }
</style>

<!--====== Start Hero Section ======-->
<section class="hero-area">
    <div class="hero-wrapper-three bg_cover" style="background-image: url(assets/images/hero/hero-three-bg-1.jpg);">
        <div class="container">
           
            <div class="row">
                <div class="col-lg-12">
                    <div class="hero-content text-center">
                        <img src="~/webAssets/images/logo/happy-cat.png" class="mb-4" />
                        <h1 class="wow fadeInUp" data-wow-delay=".30s">Cat Pedigree World</h1>
                        <h3 class="wow fadeInDown" data-wow-delay=".50s">What do you want to see today?</h3>
                        <div class="hero-search-wrapper wow fadeInUp" data-wow-delay=".70s">
                            <form>
                                <div class="hero-search-form tab-content">
                                    <div class="tab-pane fade show active">
                                        <div class="row">
                                            <div class="col-lg-3 col-md-6">
                                                <div class="form_group">
                                                    <input type="text" id="keyword" class="form_control" placeholder="Search By Keyword" name="search">
                                                    <i class="ti-ink-pen"></i>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-6">
                                                <div class="form_group">
                                                    <select class="wide" id="categorySelect">
                                                        <option value="-1" selected disabled>Search By Category</option>
                                                        <option value="3">Studmales</option>
                                                        <option value="2">Relocation</option>
                                                        <option value="1">Pedigree</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-6">
                                                <div class="form_group">
                                                    <input type="text" id="location" class="form_control" placeholder="Location" name="location" >
                                                    <i class="ti-location-pin"></i>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-6">
                                                <div class="form_group">
                                                    <button type="button" class="main-btn icon-btn" id="btnSearch">Search Now</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--====== End Hero Section ======-->

<!--====== Start Place Section ======-->
<section class="place-area masonry-place-area light-bg pt-115 pb-90">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="section-title text-center mb-60 wow fadeInUp">
                    <span class="sub-title">Featured List</span>
                    <h2><span class="line">Popular</span> Listings</h2>
                </div>
            </div>  
        </div>
        <div class="row" id="appendListings">
            
        </div>
    </div>
</section>
<!--====== End Place Section ======-->


