                        <div class="icon">
                            <img src="/webassets/images/elements/cat.png" width="65">
                        </div>
                        <div class="info">
                            <h4 class="title"><a href="/Listing/ViewListings?categoryId=4">Kittens</a></h4>
                            <p>Cute kittens looking for loving homes!</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-12">
                    <div class="category-item category-item-three  wow fadeInDown" style="visibility: visible; animation-name: fadeInDown;">
                        <div class="icon">
                            <img src="/webassets/images/elements/happy.png" width="65">
                        </div>
                        <div class="info">
                            <h4 class="title"><a href="/Listing/ViewListings?categoryId=2">Studs</a></h4>
                            <p>Strong, healthy males for breeding purposes.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-12">
                    <div class="category-item category-item-three  wow fadeInUp" style="visibility: visible; animation-name: fadeInUp;">
                        <div class="icon">
                            <img src="/webassets/images/elements/smile.png" width="65">
                        </div>
                        <div class="info">
                            <h4 class="title"><a href="/Listing/ViewListings?categoryId=3">Relocation</a></h4>
                            <p>Smooth relocation services for your feline friend.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 col-md-6 col-sm-12">
                    <div class="category-item category-item-three  wow fadeInDown" data-wow-delay=".15s" style="visibility: visible; animation-delay: 0.15s; animation-name: fadeInDown;">
                        <div class="icon">
