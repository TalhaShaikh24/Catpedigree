            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true" style="background-image:url('/webassets/images/images/right-arrow.png'); width: 45px; height: 45px;"></span>
