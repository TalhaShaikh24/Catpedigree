@{
    ViewData["Title"] = "Home Page";
}

<style>
    .blog-post-item-three .post-thumbnail img {
        object-fit: cover;
        width: 370px;
        height: 250px;
    }

    .carousel-item {
        height: 700px;
        object-fit: cover;
    }

    .cta-wrapper-one {
        position: relative;
        overflow: hidden;
        width: 1920px;
        height: 800px;
        background-size: cover;
    }

    .bg-fade {
        animation: fade 8s infinite;
    }

    @@keyframes fade {
        0%, 100% {
            opacity: 0;
        }

        10%, 90% {
            opacity: 1;
        }
    }



    /* Custom styles for the modal */
    .modal-dialog {
        display: flex;
        align-items: center; /* Vertically centers the modal */
        height: 100%; /* Ensure the dialog takes full height */
    }

    .modal-content {
        border-radius: 15px;
    }

    .modal-header {
        background-color: #343a40;
        color: #fff;
        border-bottom: none;
    }

    .modal-footer {
        border-top: none;
    }

    .btn-close {
        background-color: #dc3545;
        color: #fff;
        border-radius: 50%;
    }

    .modal-open .modal {
        overflow-x: hidden;
        overflow-y: hidden;
    }

    .close {
        opacity: inherit;
    }

    .features-wrapper-two.bg_dark:after {
       
        background-color: rgba(22, 22, 31, 0.9)!important;
    }

    .features-wrapper-two.bg_dark .features-item-one .content {
        color:#fff!important;
    }

    .features-wrapper-two.bg_dark .section-title h2{
        color:#fff!important;
    }

    .hero-heading-home{
        font-weight:800
    }
    .hero-heading-home{
        font-weight:600
    }
    @@media only screen and (min-width:768px){
        .hero-heading-home {
            font-size: 64px!important;
            font-weight: 800;
        }
        .hero-subheading-home {
            font-size: 38px !important;
        }
    }
    
</style>
<!-- Add this to your HTML file -->
<style>
    .spinner-btn {
        display: none;
        width: 1em;
        height: 1em;
        border: 0.2em solid rgba(0, 0, 0, 0.1);
        border-radius: 50%;
        border-top: 0.2em solid #000;
        animation: spin 0.6s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }
</style>

<!-- Modal -->
<div class="modal fade" id="dataModal" tabindex="-1" role="dialog" aria-labelledby="dataModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-white" id="dataModalLabel">Details</h5>
                <button type="button" class="close btn-close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div id="modal-content">
                    <!-- Dynamic content will be inserted here -->
                </div>
            </div>
            <div class="modal-footer">
                
            </div>
        </div>
    </div>
</div>


<!--====== Start Hero Section ======-->
<section class="hero-area py-0">
    <div class="hero-wrapper-three bg_cover" style="padding-top:60px; padding-bottom: 70px;">
        <div class="container">

            <div class="row">
                <div class="col-lg-12">
                    <div class="hero-content text-center">
                        <img src="~/webAssets/images/logo/happy-cat.png" class="mb-4" />
                        <h1 class="wow fadeInUp hero-heading-home" data-wow-delay=".30s">CatPedigreeWorld</h1>
                        <h3 class="wow fadeInDown hero-subheading-home" data-wow-delay=".50s">Life`s adventures with cat`s</h3>
                        <p class="wow fadeInDown text-white" data-wow-delay=".50s" style="line-height:24px">
                            At Catpedigreeworld, we're proud to extend our services across the globe, ensuring that no matter where you are,
                            you can easily access our comprehensive offerings. Recognizing the beauty and diversity of our global community,
                            we've tailored our services to be fully inclusive, providing support in multiple languages.
                            This commitment to worldwide accessibility and multilingual assistance underlines our dedication to serving cat enthusiasts and breeders everywhere,
                            breaking down barriers and fostering a more connected, informed, and passionate community.
                            Whether you're seeking to trace the lineage of your beloved pet or needing guidance in the world of cat breeding,
                            Catpedigreeworld is your trusted partner, speaking your language, wherever you are.
                        </p>
                        <div class="hero-search-wrapper wow fadeInUp" data-wow-delay=".70s">
                            <form>
                                <div class="hero-search-form tab-content">
                                    <div class="tab-pane fade show active">
                                        <div class="row">
                                            <div class="col-lg-3 col-md-6">
                                                <div class="form_group">
                                                    <input type="text" id="keyword" class="form_control" placeholder="Search By Keyword" name="search">
                                                    <i class="ti-ink-pen"></i>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-6">
                                                <div class="form_group">
                                                    <select class="wide" id="categorySelect">
                                                        <option value="-1" selected disabled>Search By Category</option>
                                                        <option value="1">Pedigree</option>
                                                        <option value="2">Studs</option>
                                                        <option value="3">Relocation</option>
                                                        <option value="4">Kittens To Sell</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-6">
                                                <div class="form_group">
                                                    <input type="text" id="location" class="form_control" placeholder="Location" name="location">
                                                    <i class="ti-location-pin"></i>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-6">
                                                <div class="form_group">
                                                    <button type="button" class="main-btn icon-btn" id="btnSearch">Search Now</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                           
                        </div>
                        <p class="pt-30 pb-6 text-center text-white" style="font-weight: bolder; font-family: sans-serif;">
                            Start your search for a new furry friend like a kitten or a cat that needs relocation,
                            a top-notch stud to introduce fresh bloodlines, or pedigrees by simply entering your location,
                            breed, or keyword in our search bar.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--====== End Hero Section ======-->
