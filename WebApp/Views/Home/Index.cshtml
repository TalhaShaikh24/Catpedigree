<!--====== Advertisement Section ======-->
<section class="cta-area d-none" id="advertisemnetSection">
    <div class="row justify-content-center pt-5">
        <div class="col-lg-6">
            <div class="section-title text-center mb-60 wow fadeInUp">
                <span class="sub-title">Advertisements</span>
                <h2><span class="line">Advertisement</span> Banners</h2>
            </div>
        </div>
    </div>
    <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
        <ol class="carousel-indicators">
            <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
            <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
            <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
        </ol>
        <div class="carousel-inner">
        </div>
        <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true" style="background-image:url('/webassets/images/left-arrow.png'); width: 45px; height: 45px;"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true" style="background-image:url('/webassets/images/right-arrow.png'); width: 45px; height: 45px;"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>
</section>
<!--====== End Advertisement Section ======-->
<!--====== Start category Section ======-->
<section class="category-area">
    <div class="category-wrapper-bg bg_cover pt-75 pb-50" style="background-image: url(assets/images/bg/catgory-bg-1.jpg);">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-7">
                    <div class="section-title text-center mb-60 wow fadeInUp">
                        <span class="sub-title">What We Offer</span>
                        <h2>Popular Category</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="category-item category-item-three mb-30 wow fadeInUp">
                        <div class="icon">
                            <img src="~/webAssets/images/category/cat.png" width="90" />
                        </div>
                        <div class="info">
                            <h4 class="title"><a href="/Listing/ViewListings?categoryId=4">Kittens</a></h4>
                            <p>Cute kittens looking for loving homes!</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="category-item category-item-three mb-30 wow fadeInDown">
                        <div class="icon">
                            <img src="~/webAssets/images/category/happy.png" width="90" />
                        </div>
                        <div class="info">
                            <h4 class="title"><a href="/Listing/ViewListings?categoryId=2">Studs</a></h4>
                            <p>Strong, healthy males for breeding purposes.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="category-item category-item-three mb-30 wow fadeInUp">
                        <div class="icon">
                            <img src="~/webAssets/images/category/smile.png" width="90" />
                        </div>
                        <div class="info">
                            <h4 class="title"><a href="/Listing/ViewListings?categoryId=3">Relocation</a></h4>
                            <p>Smooth relocation services for your feline friend.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="category-item category-item-three mb-30 wow fadeInDown" data-wow-delay=".15s">
                        <div class="icon">
                            <img src="~/webAssets/images/category/pedigree.png" width="75" />
                        </div>
                        <div class="info">
                            <h4 class="title"><a href="/Listing/ViewListings?categoryId=1">Pedigree</a></h4>
