@{
    ViewData["Title"] = "Home Page";
}

<style>
    .blog-post-item-three .post-thumbnail img{
        object-fit: cover;
        width: 370px;
        height: 250px;
    }

    .carousel-item{
        height:700px;
        object-fit:cover;
    }

    .cta-wrapper-one {
        position: relative;
        overflow: hidden;
        width: 1920px;
        height: 800px;
        background-size: cover;
    }

    .bg-fade {
        animation: fade 8s infinite;
    }

    @@keyframes fade {
        0%, 100% {
            opacity: 0;
        }
        10%, 90% {
            opacity: 1;
        }
    }

</style>



<!--====== Start Hero Section ======-->
<section class="hero-area">
    <div class="hero-wrapper-three bg_cover" style="background-image: url(assets/images/hero/hero-three-bg-1.jpg);">
        <div class="container">
           
            <div class="row">
                <div class="col-lg-12">
                    <div class="hero-content text-center">
                        <img src="~/webAssets/images/logo/happy-cat.png" class="mb-4" />
                        <h1 class="wow fadeInUp" data-wow-delay=".30s">CatPedigreeWorld</h1>
                        <h3 class="wow fadeInDown" data-wow-delay=".50s">Life adventures with cats</h3>
                        <div class="hero-search-wrapper wow fadeInUp" data-wow-delay=".70s">
                            <form>
                                <div class="hero-search-form tab-content">
                                    <div class="tab-pane fade show active">
                                        <div class="row">
                                            <div class="col-lg-3 col-md-6">
                                                <div class="form_group">
                                                    <input type="text" id="keyword" class="form_control" placeholder="Search By Keyword" name="search">
                                                    <i class="ti-ink-pen"></i>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-6">
                                                <div class="form_group">
                                                    <select class="wide" id="categorySelect">
                                                        <option value="-1" selected disabled>Search By Category</option>
                                                        <option value="1">Pedigree</option>
                                                        <option value="2">Studs</option>
                                                        <option value="3">Relocation</option>
                                                        <option value="4">Kittens To Sell</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-6">
                                                <div class="form_group">
                                                    <input type="text" id="location" class="form_control" placeholder="Location" name="location" >
                                                    <i class="ti-location-pin"></i>
                                                </div>
                                            </div>
                                            <div class="col-lg-3 col-md-6">
                                                <div class="form_group">
                                                    <button type="button" class="main-btn icon-btn" id="btnSearch">Search Now</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--====== End Hero Section ======-->

<!--====== Start Top Listing Section ======-->
<section class="place-area masonry-place-area light-bg pt-115 pb-90" id="sectionTopListings" style="display:none;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="section-title text-center mb-60 wow fadeInUp">
                    <span class="sub-title">Top List</span>
                    <h2><span class="line">Top</span> Listings</h2>
                </div>
            </div>  
        </div>
        <div class="row" id="appendTopListings">
            
        </div>
    </div>
</section>
<!--====== End Top Listing Section ======-->

<!--====== Start Vet & Rimmed Listing Section ======-->
<section class="place-area masonry-place-area light-bg pt-115 pb-90" id="sectionVetRimmedListings" style="display:none;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="section-title text-center mb-60 wow fadeInUp">
                    <span class="sub-title">Promoted Lists</span>
                    <h2><span class="line">Vet & Rimmed</span> Listings</h2>
                </div>
            </div>  
        </div>
        <div class="row" id="appendVetandRimmedListings">
            
        </div>
    </div>
</section>
<!--====== End Vet & Rimmed Listing Section ======-->

<!--====== Start Listing Section ======-->
<section class="place-area masonry-place-area light-bg pt-115 pb-90">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="section-title text-center mb-60 wow fadeInUp">
                    <span class="sub-title">Featured List</span>
                    <h2><span class="line">Popular</span> Listings</h2>
                </div>
            </div>  
        </div>
        <div class="row" id="appendListings">
            
        </div>
        <div class="row">
            <div class="col-lg-12">
                <div class="button text-center mt-40 wow fadeInUp">
                    <a href="@Url.Action("ViewListings","Listing")" class="main-btn icon-btn">View All</a>
                </div>
            </div>
        </div>
    </div>
</section>
<!--====== End Listing Section ======-->


<!--====== Advertisement Section ======-->
<section class="cta-area d-none" id="advertisemnetSection">
    <div class="row justify-content-center pt-5">
        <div class="col-lg-6">
            <div class="section-title text-center mb-60 wow fadeInUp">
                <span class="sub-title">Advertisements</span>
                <h2><span class="line">Advertisement</span> Banners</h2>
            </div>
        </div>
    </div>
    <div id="carouselExampleIndicators" class="carousel slide" data-ride="carousel">
        <ol class="carousel-indicators">
            <li data-target="#carouselExampleIndicators" data-slide-to="0" class="active"></li>
            <li data-target="#carouselExampleIndicators" data-slide-to="1"></li>
            <li data-target="#carouselExampleIndicators" data-slide-to="2"></li>
        </ol>
        <div class="carousel-inner">
           
        </div>
        <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true" style="background-image:url('/webassets/images/left-arrow.png'); width: 45px; height: 45px;"></span>
            <span class="sr-only">Previous</span>
        </a>
        <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true" style="background-image:url('/webassets/images/right-arrow.png'); width: 45px; height: 45px;"></span>
            <span class="sr-only">Next</span>
        </a>
    </div>
</section>
<!--====== End Advertisement Section ======-->


<!--====== Start category Section ======-->
<section class="category-area">
    <div class="category-wrapper-bg bg_cover pt-75 pb-50" style="background-image: url(assets/images/bg/catgory-bg-1.jpg);">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-7">
                    <div class="section-title text-center mb-60 wow fadeInUp">
                        <span class="sub-title">What We Offer</span>
                        <h2>Popular Category</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="category-item category-item-three mb-30 wow fadeInUp">
                        <div class="icon">
                            <img src="~/webAssets/images/category/cat.png" width="90" />
                        </div>
                        <div class="info">
                            <h4 class="title"><a href="/Listing/ViewListings?categoryId=4">Kittens</a></h4>
                            <p>Cute kittens looking for loving homes!</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="category-item category-item-three mb-30 wow fadeInDown">
                        <div class="icon">
                            <img src="~/webAssets/images/category/happy.png" width="90" />
                        </div>
                        <div class="info">
                            <h4 class="title"><a href="/Listing/ViewListings?categoryId=2">Studs</a></h4>
                            <p>Strong, healthy males for breeding purposes.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="category-item category-item-three mb-30 wow fadeInUp">
                        <div class="icon">
                            <img src="~/webAssets/images/category/smile.png" width="90" />
                        </div>
                        <div class="info">
                            <h4 class="title"><a href="/Listing/ViewListings?categoryId=3">Relocation</a></h4>
                            <p>Smooth relocation services for your feline friend.</p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="category-item category-item-three mb-30 wow fadeInDown" data-wow-delay=".15s">
                        <div class="icon">
                            <img src="~/webAssets/images/category/pedigree.png" width="75" />
                        </div>
                        <div class="info">
                            <h4 class="title"><a href="/Listing/ViewListings?categoryId=1">Pedigree</a></h4>
                            <p>Explore cats with prestigious lineage and traits.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--====== End category Section ======-->

<!--====== Start Features Section ======-->
<section class="features-area">
    <div class="features-wrapper-two bg_cover pt-115 pb-80" style="background-image: url(assets/images/bg/features-bg-1.jpg);">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-6">
                    <div class="section-title section-title-white text-center mb-50 wow fadeInUp">
                        <span class="sub-title">Working Process</span>
                        <h2>How It Works</h2>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="features-item features-item-one mb-40 wow fadeInDown">
                        <div class="icon">
                            <i class="flaticon-map"></i>
                        </div>
                        <div class="content">
                            <h4>Submission Protocol</h4>
                            <p>
                                Users submit cat listings via an intuitive interface, providing essential details and photos for a seamless process.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="features-item features-item-one mb-40 wow fadeInUp" data-wow-delay="20ms">
                        <div class="icon">
                            <i class="flaticon-star"></i>
                        </div>
                        <div class="content">
                            <h4>Approval Process</h4>
                            <p>
                                Our team meticulously reviews each submission to verify accuracy and ensure compliance before publication.
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="features-item features-item-one mb-40 wow fadeInDown">
                        <div class="icon">
                            <i class="flaticon-calendar"></i>
                        </div>
                        <div class="content">
                            <h4>Listing Publication</h4>
                            <p>
                                Approved listings are promptly published, connecting cats with potential adopters or loving homes.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section><!--====== End Features Section ======-->
