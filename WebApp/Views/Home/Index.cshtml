<section class="blog-area pt-115 pb-120">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="section-title text-center mb-60 wow fadeInUp">
                    <span class="sub-title">Recent Articles</span>
                    <h2>Blogs</h2>
                </div>
            </div>
        </div>
        <div class="row" id="appendBlogs">
           
