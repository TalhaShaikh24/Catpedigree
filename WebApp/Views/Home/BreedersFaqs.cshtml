<!-- Accordion section -->
<section class="Myaccordion py-5 ">
    <div class="container">
        <h2 class="text-center lines" style="color: #ED334F;">FAQ</h2>
        <p class="text-center pb-3 pt-1">If you can´t find the answer you´re looking for, just contact us via chat or by <a href="@Url.Action("Contact","Home")" style="color:rgba(2, 112, 224, 1.0);">clicking here</a></p>
        <div class="row">
            <div class="col-12">
                <div class="panel-group" id="accordion" role="tablist" aria-multiselectable="true">
                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingTwo">
                            <h4 class="panel-title">
                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                                   href="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo">
                                    Is VAT included in the price?
                                </a>
                            </h4>
                        </div>
                        <div id="collapseTwo" class="panel-collapse collapse" role="tabpanel"
                             aria-labelledby="headingTwo">
                            <div class="panel-body">
                                <p>
                                    For all our products and services VAT will be calculated and added during
                                    checkout.
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingTwo">
                            <h4 class="panel-title">
                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                                   href="#collapseOne" aria-expanded="false" aria-controls="collapseOne">
                                    I would like to upgrade my Mediation package. Is that possible?
                                </a>
                            </h4>
                        </div>
                        <div id="collapseOne" class="panel-collapse collapse" role="tabpanel"
                             aria-labelledby="headingTwo">
                            <div class="panel-body">
                                <p>
                                    Absolutely! You will only need to pay the price difference between your current
                                    package and the new one. Rest assured, any costs already paid for successfully
                                    mediated kittens will not be deducted.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingThree">
                            <h4 class="panel-title">
                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                                   href="#collapseThree" aria-expanded="false" aria-controls="collapseThree">
                                    Can I cancel my Mediation Subscription?
                                </a>
                            </h4>
                        </div>
                        <div id="collapseThree" class="panel-collapse collapse" role="tabpanel"
                             aria-labelledby="headingThree">
                            <div class="panel-body">
                                <p>
                                    You have the option to cancel your subscription at any time before it is set to
                                    renew. The current year will not be refunded.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingThree">
                            <h4 class="panel-title">
                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                                   href="#collapsefour" aria-expanded="false" aria-controls="collapsefour">
                                    Is it safe to upload my Pedigrees?
                                </a>
                            </h4>
                        </div>
                        <div id="collapsefour" class="panel-collapse collapse" role="tabpanel"
                             aria-labelledby="headingfour">
                            <div class="panel-body">
                                <p>Rest assured, we will thoroughly review and edit any sensitive information before featuring your pedigree on the website.</p>
                            </div>
                        </div>
                    </div>
                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingThree">
                            <h4 class="panel-title">
                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                                   href="#collapsesix" aria-expanded="false" aria-controls="collapsesix">
                                    Is it possible to upgrade my Listing Package?
                                </a>
                            </h4>
                        </div>
                        <div id="collapsesix" class="panel-collapse collapse" role="tabpanel"
                             aria-labelledby="headingfour">
                            <div class="panel-body">
                                <p>Unfortunately, upgrading your current Advertisement package is not an option at this time. However, you can always purchase an additional package, which will be added to your account without losing any listings from your original package.</p>
                            </div>
                        </div>
                    </div>
                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingThree">
                            <h4 class="panel-title">
                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                                   href="#collapseseavenA" aria-expanded="false" aria-controls="collapseseavenA">
                                    Do I need to buy a complete new package when I have used all the Top Listings or other Enhancements in my package?
                                </a>
                            </h4>
                        </div>
                        <div id="collapseseavenA" class="panel-collapse collapse" role="tabpanel"
                             aria-labelledby="headingfour">
                            <div class="panel-body">
                                <p>No, that won't be necessary. Just add the enhancement of your choice to your Listing and you can pay for it separately.</p>
                            </div>
                        </div>
                    </div>
                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingThree">
                            <h4 class="panel-title">
                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                                   href="#collapseseaven" aria-expanded="false" aria-controls="collapseseaven">
                                    How many pictures can I add to my listing?
                                </a>
                            </h4>
                        </div>
                        <div id="collapseseaven" class="panel-collapse collapse" role="tabpanel"
                             aria-labelledby="headingfour">
                            <div class="panel-body">
                                <p>The maximum amount is 7 pictures per Listing</p>
                            </div>
                        </div>
                    </div>
                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingThree">
                            <h4 class="panel-title">
                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                                   href="#collapsenine" aria-expanded="false" aria-controls="collapsenine">
                                    How can I change my Listing?
                                </a>
                            </h4>
                        </div>
                        <div id="collapsenine" class="panel-collapse collapse" role="tabpanel"
                             aria-labelledby="headingfour">
                            <div class="panel-body">
                                <p>Go to your personal Dashboard when you are logged in, than go to My listings. Chose the Listing you want to edit and click edit. </p>
                                <p>Note that after editing your listing your listing will be reviewed again.</p>
                            </div>
                        </div>
                    </div>

                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingThree">
                            <h4 class="panel-title">
                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                                   href="#collapseten" aria-expanded="false" aria-controls="collapseten">
                                    How can I delete my listing.?
                                </a>
                            </h4>
                        </div>
                        <div id="collapseten" class="panel-collapse collapse" role="tabpanel"
                             aria-labelledby="headingfour">
                            <div class="panel-body">
                                <p>Go to your personal Dashboard when you are logged in, than go to My listings. Chose the Listing you want to delete and click delete. </p>
                            </div>
                        </div>
                    </div>
                    <div class="panel panel-default">
                        <div class="panel-heading" role="tab" id="headingThree">
                            <h4 class="panel-title">
                                <a class="collapsed" role="button" data-toggle="collapse" data-parent="#accordion"
                                   href="#collapseeleven" aria-expanded="false" aria-controls="collapseeleven">
                                    Is it possible to place multiple enhancements on my listings?
                                </a>
                            </h4>
                        </div>
                        <div id="collapseeleven" class="panel-collapse collapse" role="tabpanel"
                             aria-labelledby="headingfour">
                            <div class="panel-body">
                                <p>Yes, this is possible.</p>
                            </div>
                        </div>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Accordion section end -->