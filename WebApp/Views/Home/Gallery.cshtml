<!-- Fancybox CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.min.css" />


<!-- Fancybox JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/watermarkjs/dist/watermark.min.js"></script>


<style>
    img {
        max-width: 100%!important;
        height: auto!important;
        vertical-align: middle!important;
        display: inline-block!important;
    }

    .grid-wrapper img.img-watermark {
        width: 135px !important;
        position: relative;
        height: auto !important;
        top: 98%;
        bottom: 10px;
        z-index: 10;
        right: 10px;
        float: right;
        opacity: 0.5;
    }
    /* Main CSS */
    .grid-wrapper > div {
        display: flex!important;
        justify-content: center!important;
        align-items: center!important;
    }

        .grid-wrapper  a , .grid-wrapper img {
            width: 100%!important;
            height: 100%!important;
            object-fit: cover!important;
            border-radius: 5px!important;
        }

    .grid-wrapper {
        display: grid!important;
        grid-gap: 10px!important;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr))!important;
        grid-auto-rows: 200px!important;
        grid-auto-flow: dense!important;
    }

        .grid-wrapper .wide {
            grid-column: span 2!important;
        }

        .grid-wrapper .tall {
            grid-row: span 2!important;
        }

        .grid-wrapper .big {
            grid-column: span 2!important;
            grid-row: span 2!important;
        }
</style>

<section class="products-area pt-160 pb-120">
    <div class="container">
        <div class="products-filter mb-30">
            <div class="row justify-content-center pt-5">
                <div class="col-lg-6">
                    <div class="section-title text-center mb-60 wow fadeInUp">
                        <span class="sub-title">Gallery</span>
                        <h2><span class="line">A Digital</span> Showcase</h2>
                    </div>
                </div>
            </div>
           @*  <div class="row gallery justify-content-between align-items-center">
                
            </div> *@

            <div class="grid-wrapper" id="grid-wrapper"></div>
                
        </div>
    </div>
</section>

<style>
    .grid {
        width: 100%;
    }

    .grid-item {
        width: 30%;
        margin-bottom: 10px;
    }

        .grid-item img {
            width: 100%;
            height: auto;
        }




</style>

<section class="pt-120 pb-120">
    <div class="container">

        <div class="row grid">
        </div>
    </div>
  


</section>




@section Scripts {
	<script src="~/webassets/pagesjs/gallery.js"></script>
}


