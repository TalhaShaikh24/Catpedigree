<style>
    .modal-title {
        color: #0d0d0d !important;
    }

    .form-group label {
        color: #676767 !important;
    }

    .hero-wrapper-three:after {
        background-color: #eaeaea !important;
    }


    .banner-item {
        position: relative;
        width: 100%;
        height: 200px;
        overflow: hidden;
        border-radius: 10px;
        transition: transform 0.3s ease;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.4);
    }

        .banner-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .banner-item:hover {
            transform: scale(1.05);
        }

            .banner-item:hover img {
                transform: scale(1.1);
            }

    .banner-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: opacity 0.3s ease;
        color: #fff;
        font-size: 24px;
        font-weight: bold;
        text-transform: uppercase;
    }

    .banner-item:hover .banner-overlay {
        opacity: 1;
    }
</style>


