@{
    Layout = null;

    var sessionTimeoutMessage = TempData["SessionTimeoutMessage"] as string;
}

@if (!string.IsNullOrEmpty(sessionTimeoutMessage))
{
    <div class="alert alert-warning">
        @sessionTimeoutMessage
    </div>
}


<!DOCTYPE html>
<html lang="en">
<head>
    <!--====== Required meta tags ======-->
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <!--====== Title ======-->
    <title>@ViewData["Title"] - WebApp</title>
    <!--====== Favicon Icon ======-->
    <link rel="shortcut icon" href="~/webassets/images/favicon.ico" type="image/png">
    <!--====== Bootstrap css ======-->
    <link rel="stylesheet" href="~/webassets/css/bootstrap.min.css">
    <!--====== FontAwesoem css ======-->
    <link rel="stylesheet" href="~/webassets/fonts/themify-icons/themify-icons.css">

    <!--====== Jquery ui css ======-->
    <link rel="stylesheet" href="~/webassets/css/jquery-ui.min.css">
    <!--====== Animate css ======-->
    <link rel="stylesheet" href="~/webassets/css/animate.css">
    <!--====== Default css ======-->
    <link rel="stylesheet" href="~/webassets/css/default.css">
    <!--====== Style css ======-->
    <link rel="stylesheet" href="~/webassets/css/style.css">
    <!--====== SweetAlert css ======-->
    <link rel="stylesheet" href="~/webassets/css/sweetalert2.css">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        .password-container {
            position: relative;
            width: 100%;
        }

            .password-container input {
                width: 100%;
                padding-right: 40px; /* Adjust this based on the icon size */
            }

            .password-container i {
                position: absolute;
                right: 10px;
                top: 50%;
                transform: translateY(-50%);
                cursor: pointer;
            }
    </style>
</head>
<body>
    <!--====== Start Preloader ======-->
    <div class="preloader" style="display:none">
        <div class="loader">
            <img src="~/webassets/images/loader.png" alt="loader">
        </div>
    </div>
    <!--====== End Preloader ======-->
    <!--====== Start Add Listing Section ======-->
    <section class="fioxen-add-listing pt-120 pb-120">
        <div class="container">
            <form>
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="add-listing-form general-listing-form mb-60 wow fadeInUp">
                            <h4 class="title">Login</h4>
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form_group">
                                        <input type="text" id="usernameEmail" class="form_control" placeholder="Username / Email" name="name" required>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="form_group password-container">
                                        <input type="password" id="password" class="form_control" placeholder="password" name="keywords" required>
                                        <i class="fa fa-eye" id="togglePassword"></i>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="button text-center">
                                        <button class="main-btn icon-btn" id="Btn_Authentication" type="button">Login</button>
                                    </div>
                                </div>
                                <div class="col-lg-12 mt-3">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="button text-left">
                                                <a style="color:#ef314c" href="/Home/UserRegistration">New here? Register an account</a>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="button text-right">
                                                <a style="color:#37474f" href="/Home/ForgotPassword">Forgot Password?</a>
                                            </div>
                                        </div>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </section><!--====== End Add Listing Section ======-->
    <!--====== Jquery js ======-->
    <script src="~/webassets/js/vendor/jquery-3.6.0.min.js"></script>
    <!--====== Popper js ======-->
    <script src="~/webassets/js/popper.min.js"></script>
    <!--====== Bootstrap js ======-->
    <script src="~/webassets/js/bootstrap.min.js"></script>
	<!--====== SweetAlerts js ======-->
	<script src="~/webassets/js/sweetalert2.min.js"></script>

	<script src="~/webassets/pagesjs/userlogin.js"></script>

</body>
</html>


