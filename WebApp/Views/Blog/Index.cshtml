<style>
    body{
        background: #f5f6f778;
    }

    .blog-standard-wrapper:last-child {
        padding-bottom: 0px !important;
        margin-bottom:10px!important;
    }

</style>

<section class="blog-area pb-70 mt-120">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="d-flex mb-30 d-none">
                    <h6 class="mr-10">Records:</h6>
                    <span id="count-display"></span>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="row m-0">
                    <div class="col-lg-12 m-0" id="appendBlogs">

                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-12">

                        <div class="button mx-4">
                            <a id="load-more" style="display:none" class="main-btn icon-btn">Load More</a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-lg-4">
                <div class="sidebar-widget-area mb-20">
                    <div class="widget search-widget mb-30 wow fadeInUp">
                        <h4 class="widget-title">Search</h4>
                        <form id="formKeywordFilter">
                            <div class="form_group">
                                <input type="text" class="form_control" placeholder="Search..." name="keywordFilter" id="keywordFilter" required>
                                <i class="ti-location-arrow" id="btnkeywordFilter"></i>
                            </div>
                        </form>
                    </div>
                    <div class="widget categories-widget mb-30 wow fadeInUp">
                        <h4 class="widget-title">Categories</h4>
                        <ul class="categories-nav" id="appendBlogCategories">
                            
                        </ul>
                    </div>
                   
                </div>
            </div>
        </div>
        
    </div>
</section>


@section Scripts {

    <script src="~/webAssets/PagesJS/Blog.js"></script>
}