<style>
    font span {
        color: unset !important;
    }
</style>
<!--====== Start Blog Section ======-->
<section class="blog-area pt-120 pb-90 mt-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-1"></div>
            <div class="col-lg-10">
                <div class="blog-details-wrapper mb-30 wow fadeInUp">
                    <div class="blog-post-item d-flex flex-column" >

                        <div class="float-left"  id="BlogDetails_Append"></div>
                        
                        <div class="comments-area">
                            <h4 class="comments-title mb-35"></h4>
                            <ul class="comments-list" id="Comments_Append">
                            </ul>
                        </div>

                        <div class="comments-respond">
                            <h4 class="comments-heading mb-20">Write a Comment</h4>
                            <form>
                                <input type="hidden" id="HDBLOGID" />
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form_group">
                                            <textarea class="form_control" name="message" id="Comment" placeholder="Write Message"></textarea>
                                        </div>
                                    </div>

                                    <div class="col-lg-12">
                                        <div class="form_group">
                                            <button type="button" class="main-btn" id="SubmitReview">Submit</button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                  
         
                </div>

            </div>
            <div class="col-lg-1"></div>

        </div>
    </div>
</section>
<!--====== End Blog Section ======-->
@section Scripts {

    <script src="~/webAssets/PagesJS/BlogDetail.js"></script>
}