<style>
    font span {
        color: unset !important;
    }
</style>
<!--====== Start Blog Section ======-->
<section class="blog-area pt-120 pb-90 mt-120">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <div class="blog-details-wrapper mb-30 wow fadeInUp">
                    <div class="blog-post-item d-flex flex-column" >

                        <div class="float-left"  id="BlogDetails_Append"></div>
                        
                        <div class="comments-area">
                            <h4 class="comments-title mb-35"></h4>
                            <ul class="comments-list" id="Comments_Append">
                            </ul>
                        </div>

                        <div class="comments-respond">
                            <h4 class="comments-heading mb-20">Write a Comment</h4>
                            <form>
                                <input type="hidden" id="HDBLOGID" />
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form_group">
                                            <textarea class="form_control" name="message" id="Comment" placeholder="Write Message"></textarea>
                                        </div>
                                    </div>

                                    <div class="col-lg-12">
                                        <div class="form_group">
                                            <button type="button" class="main-btn" id="SubmitReview">Submit</button>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                  
         
                </div>

            </div>

            <div class="col-lg-4">
                <div class="sidebar-widget-area">
                    <div class="widget search-widget mb-30 wow fadeInUp">
                        <h4 class="widget-title">Search</h4>
                        <form>
                            <div class="form_group">
                                <input type="email" class="form_control" placeholder="Search..." name="email" required>
                                <i class="ti-location-arrow"></i>
                            </div>
                        </form>
                    </div>
                    <div class="widget categories-widget mb-30 wow fadeInUp">
                        <h4 class="widget-title">Categories</h4>
                        <ul class="categories-nav">
                            <li><a href="#">Restaurant <span>(10)</span></a></li>
                            <li><a href="#">Museums <span>(12)</span></a></li>
                            <li><a href="#">Business <span>(05)</span></a></li>
                            <li><a href="#">Tour & Travel <span>(10)</span></a></li>
                            <li><a href="#">Uncategory <span>(03)</span></a></li>
                        </ul>
                    </div>
                   
                </div>
            </div>
        </div>
    </div>
</section>
<!--====== End Blog Section ======-->
@section Scripts {

    <script src="~/webAssets/PagesJS/BlogDetail.js"></script>
}