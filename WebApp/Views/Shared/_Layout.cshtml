@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor Accessor
@using Newtonsoft.Json;
@{
    string userJson = @Accessor.HttpContext.Request.Cookies["user"];
}

<!DOCTYPE html>
<html lang="en">
<head>
    <!--====== Required meta tags ======-->
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <!--====== Title ======-->
    <title>@ViewData["Title"] - WebApp</title>
    <!--====== Favicon Icon ======-->
    <link rel="shortcut icon" href="~/webassets/images/favicon.ico" type="image/png">
    <!--====== Bootstrap css ======-->
    <link rel="stylesheet" href="~/webassets/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/12.1.6/css/intlTelInput.css">
    <!--====== FontAwesoem css ======-->
    <link rel="stylesheet" href="~/webassets/fonts/themify-icons/themify-icons.css">
    <!--====== Flaticon css ======-->
    <link rel="stylesheet" href="~/webassets/fonts/flaticon/flaticon.css">
    <!--====== Magnific Popup css ======-->
    <link rel="stylesheet" href="~/webassets/css/magnific-popup.css">
    <!--====== Slick css ======-->
    <link rel="stylesheet" href="~/webassets/css/slick.css">
    <!--====== Nice-select css ======-->
    <link rel="stylesheet" href="~/webassets/css/nice-select.css">
    <!--====== Jquery ui css ======-->
    <link rel="stylesheet" href="~/webassets/css/jquery-ui.min.css">
    <!--====== Animate css ======-->
    <link rel="stylesheet" href="~/webassets/css/animate.css">
    <!--====== Default css ======-->
    <link rel="stylesheet" href="~/webassets/css/default.css">
    <!--====== Style css ======-->
    <link rel="stylesheet" href="~/webassets/css/style.css">

    <link href="~/webassets/css/sweetalert2.css" rel="stylesheet" />

    <!--====== Jquery js ======-->
    <script src="~/webassets/js/vendor/jquery-3.6.0.min.js"></script>

    <style>
        .nice-select .list {
            max-height: 300px;
            overflow-y: scroll;
        }

        .intl-tel-input{

            width:100%;
        }

        .intl-tel-input .flag-container{

            padding:0px!important;
        }

        .listing-item .listing-thumbnail img {
            height: 290px;
            width: 100%;
            object-fit: cover;
        }

        .listing-item.listing-grid-item-two {
            box-shadow: 0px 10px 15px -3px rgba(0, 0, 0, 0.1);
            border-radius: 14px;
        }

        .blog-details-wrapper .comments-area .comments-list .comment .comment-avatar img {
            width: 60px!important;
            height: 60px!important;
            border-radius: 100px!important;
        }

        .blog-details-wrapper .comments-area .comments-list .comment .comment-avatar {
            min-width: auto!important;
            max-width: none!important;
            height: 120px!important;
            margin-right: 30px!important;
        }
    </style>
</head>
<body>
    <!--====== Start Preloader ======-->
    <div class="preloader">
        <div class="loader">
            <img src="~/webassets/images/loader.png" alt="loader">
        </div>
    </div>
    <!--====== End Preloader ======-->
    <!--====== Start Header Section ======-->
    <header class="header-area header-area-three transparent-header">
        <div class="header-top">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-md-4">
                        <div class="top-social">
                            <ul class="social-link">
                                <li><span>Follow us:</span></li>
                                <li><a href="#"><i class="ti-facebook"></i></a></li>
                                <li><a href="#"><i class="ti-twitter-alt"></i></a></li>
                                <li><a href="#"><i class="ti-pinterest"></i></a></li>
                                <li><a href="#"><i class="ti-dribbble"></i></a></li>
                                <li><a href="#"><i class="ti-instagram"></i></a></li>
                            </ul>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="top-content text-center">
                            <p>We Have Special Offers <a href="index.html">Tagline</a></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="header-navigation">
            <div class="container">
                <div class="primary-menu">
                    <div class="row align-items-center">
                        <div class="col-lg-2 col-5">
                            <div class="site-branding">
                                <a href="@Url.Action("Index","Home")" class="brand-logo"><img src="~/webassets/images/logo/logo-1.png" alt="Brand Logo"></a>

                                

                            </div>
                          
                        </div>
                        <div class="col-lg-7 col-2">
                            <div class="nav-menu">
                                <div class="navbar-close"><i class="ti-close"></i></div>
                                <nav class="main-menu">
                                    <ul>
                                        <li class="menu-item">
                                            <a href="@Url.Action("Index","Home")" class="active">Home</a>
                                        </li>
                                        <li class="menu-item"><a href="@Url.Action("ViewListings","Listing")">Explore</a></li>
                                        <li class="menu-item"><a href="@Url.Action("AllVendors","Vendor")">Vendors</a></li>
                                        <li class="menu-item">
                                            <a href="@Url.Action("Pricing","Packages")">Pricing Plans</a>
                                        </li>
                                        <li class="menu-item">
                                            <a href="@Url.Action("Index","Blog")">Blogs</a>
                                        </li>

                                       @{
                                            
                                        if (String.IsNullOrEmpty(@Accessor.HttpContext.Request.Cookies["authorization"]) && String.IsNullOrEmpty(userJson))
                                                                       
                                         {

                                                <li class="menu-item">

                                                    <a href="@Url.Action("login","Home")" id="btnLogIn">Sign In</a>
                                                </li>
                            
                                        }
                                        else
                                        {


                                                <li class="menu-item">


                                                    <a href="javascript:void(0);" id="btnLogOFf">Log out</a>
                                                </li>
                                        }
                                        }
                                       
                           
                                    </ul>
                                </nav>
                            </div>
                        </div>
                        <div class="col-lg-3 col-5">
                            <div class="header-right-nav">
                                <ul class="d-flex align-items-center" id="headerButtons">
                                    
                                    <li class="user-btn"> <a href="/Dashboard" class="icon"> <i class="flaticon-avatar"> </i></a> </li>
                                    <li id="btnAddListing" class="hero-nav-btn"><a href="@Url.Action("Index","Listing")" class="main-btn icon-btn">Add Listing</a></li>
                                    <li class="nav-toggle-btn">
                                        <div class="navbar-toggler">
                                        
                                            
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <!--====== End Header Section ======-->
  
     @RenderBody()


    <!--====== Start Footer ======-->
    <footer class="footer-area">
        <div class="footer-wrapper-one dark-black pt-90">
            <div class="footer-widget pb-60">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-4 col-md-6 col-sm-12">
                            <div class="widget about-widget mb-40 wow fadeInUp" data-wow-delay="10ms">
                                <a href="@Url.Action("Index","Home")" class="brand-logo"><img src="~/webassets/images/logo/logo-1.png" alt="Brand Logo"></a>
                                <div>
                                    <h6 class="text-white mb-2 mt-4">CAT PEDIGREE WORLD</h6>
                                    <p>
                                        THE place to be if you are looking for a pedigree cat. Here you can find your beautiful and unique breed with pedigree all over the world!
                                    </p>
                                </div> <div>
                                    <h6 class="text-white mb-2 mt-4">UPLOAD YOUR PEDIGREE</h6>
                                    <p>
                                        
                                        Uploading your pedigree is very simple so everyone can see your special lines. There are kittens, stud-male’s, adults and re-homing cat’s. Take a look and try it your self.
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-6 col-sm-12">
                            <div class="widget categories-widget mb-40 wow fadeInUp" data-wow-delay="20ms">
                                <h4 class="widget-title">Useful Links</h4>
                                <ul class="categories-link">
                                    <li><a href="#">Home</a></li>
                                    <li><a href="#">Explore</a></li>
                                    <li><a href="#">Blogs</a></li>
                                    <li><a href="#">Gallery</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-2 col-md-6 col-sm-12">
                            <div class="widget categories-widget mb-40 wow fadeInUp" data-wow-delay="30ms">
                                <h4 class="widget-title">Categories</h4>
                                <ul class="categories-link">
                                    <li><a href="#">Kittens</a></li>
                                    <li><a href="#">Studmales</a></li>
                                    <li><a href="#">Relocation</a></li>
                                    <li><a href="#">Pedigree</a></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-12">
                            <div class="widget newsletter-widget mb-40 wow fadeInUp" data-wow-delay="40ms">
                                <h4 class="widget-title">Who We Are</h4>
                                <p>
                                    Catpedigreeworld is made especially for all cat’s with a pedigree. Here you can always find information about your special cat breed and contact the owner if you are interested in the Cattery.
                                    
                                </p>
                                <p>  With a few clicks you can see the lines if it fits for your own breeding program. Every breeder is checked for his licences, to prevent scammers</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="copyright-area">
                <div class="container">
                    <div class="row align-items-center">
                        <div class="col-lg-6">
                            <div class="copyright-text">
                                <p>Copyright &copy; 2024. All rights reserved to <span>Catpedigree</span></p>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div class="copyright-link">
                                <ul>
                                    <li><a href="@Url.Action("Terms","Home")">Terms & Conditions</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <input type="hidden" id="baseApiUrl" value="@Configuration.GetSection("UrlSetting").GetSection("baseApiUrl").Value" />
    <input type="hidden" id="baseWebUrl" value="@Configuration.GetSection("UrlSetting").GetSection("baseWebUrl").Value" />


    <!--====== End Footer ======-->
    <!--====== back-to-top ======-->
    <a href="#" class="back-to-top"><i class="ti-angle-up"></i></a>
        
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.30.1/moment.min.js"></script>

    <!--====== Popper js ======-->
    <script src="~/webassets/js/popper.min.js"></script>
    <!--====== Bootstrap js ======-->
    <script src="~/webassets/js/bootstrap.min.js"></script>
    <!--====== Slick js ======-->
    <script src="~/webassets/js/slick.min.js"></script>
    <!--====== Magnific Popup js ======-->
    <script src="~/webassets/js/jquery.magnific-popup.min.js"></script>
    <!--====== Isotope js ======-->
    <script src="~/webassets/js/isotope.pkgd.min.js"></script>
    <!--====== Imagesloaded js ======-->
    <script src="~/webassets/js/imagesloaded.pkgd.min.js"></script>
    <!--====== Nice-select js ======-->
    <script src="~/webassets/js/jquery.nice-select.min.js"></script>
    <!--====== counterup js ======-->
    <script src="~/webassets/js/jquery.counterup.min.js"></script>
    <!--====== waypoints js ======-->
    <script src="~/webassets/js/jquery.waypoints.js"></script>
    <!--====== Ui js ======-->
    <script src="~/webassets/js/jquery-ui.min.js"></script>
   
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/12.1.6/js/intlTelInput.min.js"></script>
    <!--====== Wow js ======-->
    <script src="~/webassets/js/wow.min.js"></script>
    <!--====== Main js ======-->
    <script src="~/webassets/js/main.js"></script>
    <script src="~/webassets/js/sweetalert2.min.js"></script>

    <script>

        $("#btnLogOFf").click(function () {


            postRequest("/Account/Logout", null, function (res) {

                if (res.status == 200) {

                    window.location.href = "/";
                }
              
            });
        });

        function postRequest(url, requestData, handledata) {

            $.ajax({
                type: 'POST',
                contentType: 'application/json;charset=utf-8',
                dataType: "json",
                url: url,
                headers: {

                },

                data: JSON.stringify(requestData),
                success: function (data, textstatus, xhr) {
                    handledata(data);
                },
                error: function (xhr, textstatus, errorThrown) {
                    swal({
                        title: "Error",
                        text: "Something Went Wrong!",
                        icon: "error",
                        dangerMode: true,
                    })
                }
            });
        }

    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
