        .currency-dropdown .nice-select {
            background-color: transparent;
            color: #fff !important;
            font-weight: 900 !important;
            border:none;
        }

            .currency-dropdown .nice-select:after {
                color: #fff !important;
            }

            .currency-dropdown .nice-select .list {
                background-color: #4d4f5f;
                box-shadow: 3px 5px 7px 2px #33333375;
                max-height: 400px;
                height: auto;
                overflow-y: auto;
                width: max-content;
            }

