    <script>

        $(document).ready(function () {
            GetFooterAdvertisments();
        })

        function GetFooterAdvertisments() {

            postRequest('/Advertisement/GetHomeAdvertisments/' + 3, null, function (res) {

                if (res.status == 200) {

                    if (res.data != null) {
                        if (res.data.length == 1) {
                           
                           
                            $.each(res.data, function (index, item) {
                                var html = `<img class="footerAdverts" src="${baseApiUrl + item.paidAdvertisments}" alt="${item.alt}"/>`
                                $('#appendFooterAdverts').append(html);
                            });
                            $(".footerAdverts").show();
                        }
                        else if (res.data.length > 1) {
                            $.each(res.data, function (index, item) {
                                var html = `<img class="footerAdverts" src="${baseApiUrl + item.paidAdvertisments}" alt="${item.alt}"/>`
                                $('#appendFooterAdverts').append(html);
                            });

                            var $images = $('.footerAdverts'); // Get all images
                            var index = 0; // Initialize index

                            // Show the first image initially
                            $images.eq(index).show();

                            // Function to rotate images
                            function rotateImages() {
                                // Hide the current image
                                $images.eq(index).hide();

                                // Increment index or reset to 0 if it exceeds the number of images
                                index = (index + 1) % $images.length;

                                // Show the next image
                                $images.eq(index).show();
                            }

                            // Set interval to rotate images every X seconds
                            setInterval(rotateImages, 800);
                           
                        }
                    }
                }
                if (res.status == 304) {

                    Swal.fire({
                        title: "Error",
                        text: res.responseMsg,
                        icon: "error"
                    })
                }
                if (res.status == 305) {

                    Swal.fire({
                        title: "Error",
                        text: res.responseMsg,
                        icon: "error"
                    })
                }
                if (res.status == 401) {

                    Swal.fire({
                        title: "Error",
                        text: res.responseMsg,
                        icon: "error"
                    })
                }
                if (res.status == 403) {

                    Swal.fire(res.responseMsg, {
                        icon: "error",
                        title: "Error"
                    });
                }
                if (res.status == 320) {

                    Swal.fire({
                        title: "Error",
                        text: res.responseMsg,
                        icon: "error"
                    })
                }
                if (res.status == 500) {

                    Swal.fire({
                        title: "Error",
                        text: res.responseMsg,
                        icon: "error"
                    })
                }
                if (res.status == 600) {

                    Swal.fire({
                        title: "Warning",
                        text: res.responseMsg,
                        icon: "warning"
                    })

                }
            });
        }

        $("#btnLogOFf").click(function () {


            postRequest("/Account/Logout", null, function (res) {

                if (res.status == 200) {

                    window.location.href = "/";
                }
              
            });
        });

        function postRequest(url, requestData, handledata) {

            $.ajax({
                type: 'POST',
                contentType: 'application/json;charset=utf-8',
                dataType: "json",
                url: url,
                headers: {

                },

                data: JSON.stringify(requestData),
                success: function (data, textstatus, xhr) {
                    handledata(data);
                },
                error: function (xhr, textstatus, errorThrown) {
                    swal({
                        title: "Error",
                        text: "Something Went Wrong!",
                        icon: "error",
                        dangerMode: true,
                    })
                }
            });
        }

    </script>
