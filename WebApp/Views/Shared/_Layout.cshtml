    <script type="text/javascript">




        $(document).on('click', '.google_translate_element', function (event) {
            event.preventDefault();

        })


        // Function to initialize Google Translate Element
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'en',
                includedLanguages: 'en,es,fr,de,it,ja,ko,zh-CN,nl,da,sv,fi,el,he,no,pl,ro,ru,pt,be,cs,bg,hu,tr',
                layout: google.translate.TranslateElement.InlineLayout.SIMPLE
            }, 'google_translate_element');
        }


        // Function to save selected language in local storage
        function saveLanguagePreference(lang) {
            localStorage.setItem('preferredLanguage', lang);
        }

        // Function to apply saved language preference
        function applySavedLanguage() {
            var lang = localStorage.getItem('preferredLanguage');
            if (lang) {
                var translateFrame = document.querySelector('iframe.goog-te-banner-frame');
                if (translateFrame) {
                    var translateDoc = translateFrame.contentDocument || translateFrame.contentWindow.document;
                    var langButtons = translateDoc.querySelectorAll('button[lang]');
                    for (var i = 0; i < langButtons.length; i++) {
                        if (langButtons[i].getAttribute('lang') === lang) {
                            langButtons[i].click();
                            break;
                        }
                    }
                }
            }
        }

        // Initialize Google Translate
        function initializeGoogleTranslate() {
            var script = document.createElement('script');
            script.type = 'text/javascript';
            script.src = '//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
            document.getElementsByTagName('head')[0].appendChild(script);

            // Apply saved language preference after Google Translate loads
            script.onload = function () {
                setTimeout(applySavedLanguage, 1000); // Delay to ensure translate frame is loaded
            };
        }

        // Save language selection on change
        document.addEventListener('click', function (event) {
            if (event.target.tagName === 'A' && event.target.classList.contains('goog-te-menu2-item')) {
                var lang = event.target.getAttribute('lang');
                saveLanguagePreference(lang);
            }
        });

        window.onload = function () {
            // Ensure initializeGoogleTranslate is called as a function
            initializeGoogleTranslate();

            // Function to check if an element with the specified class exists inside an iframe
            function checkElementInIframe(iframe, className) {
                // Access the iframe's document
                var iframeDocument = iframe.contentDocument || iframe.contentWindow.document;

                // Check if the element with the specified class exists in the iframe's document
                var element = iframeDocument.querySelector(`.${className}`);

                // Return the iframe document and the found element (if any)
                return { document: iframeDocument, element: element };
            }

            // Function to insert CSS into the iframe's head
            function insertCssIntoIframe(iframeDocument, cssRules) {
                var head = iframeDocument.head || iframeDocument.getElementsByTagName('head')[0];
                var style = iframeDocument.createElement('style');
                style.type = 'text/css';

                if (style.styleSheet) {
                    // This is required for IE8 and below.
                    style.styleSheet.cssText = cssRules;
                } else {
                    style.appendChild(iframeDocument.createTextNode(cssRules));
                }

                head.appendChild(style);
            }

            // Function to continuously check for the element inside all iframes
            function continuouslyCheckElement(iframeSelector, className, cssRules, interval = 1000, maxAttempts = 10) {
                let attempts = 0;

                // Create a timer to repeatedly check for the element
                const timer = setInterval(() => {
                    // Get all iframes matching the selector
                    var iframes = document.querySelectorAll(iframeSelector);

                    let foundElement = false;

                    iframes.forEach((iframe) => {
                        iframe.style.boxShadow = '2px 6px 8px 2px #00000057';
                        iframe.style.borderRadius = '14px';
                        iframe.style.marginTop = '10px';
                        const result = checkElementInIframe(iframe, className);
                        const iframeDocument = result.document;
                        const element = result.element;

                        if (element) {
                            console.log('Element found inside the iframe.');

                            // Insert CSS into the iframe's document
                            if (iframeDocument) {
                                insertCssIntoIframe(iframeDocument, cssRules);
                            }

                            foundElement = true; // Mark that we found the element
                        }
                    });

                    if (foundElement) {
                        clearInterval(timer); // Stop the timer if the element is found in any iframe
                    } else {
                        attempts++;
                        console.log(`Attempt ${attempts}: Element not found inside the iframes.`);

                        // Stop the timer after reaching the maximum number of attempts
                        if (attempts >= maxAttempts) {
                            console.log('Maximum attempts reached. Stopping check.');
                            clearInterval(timer);
                        }
                    }
                }, interval);
            }

            // Usage
            var iframeSelector = 'iframe.skiptranslate'; // Target the iframe with class 'skiptranslate'
            var className = 'VIpgJd-ZVi9od-vH1Gmf'; // Replace with the class name you're looking for
            var cssRules = `
                    body .VIpgJd-ZVi9od-vH1Gmf {
                        max-height: 600px;
                        height: auto !important;
                        overflow-y: auto;
                        width: 300px !important;
                        max-width: 400px;
                        border: 1px solid #fff !important;
                        border-radius: 14px;
                        padding-bottom: 20px;
                        background-color: #4d4f5f;
                        box-shadow: none !important;
                    }
                    table{
                          width:100%!important;
                    }
                    .VIpgJd-ZVi9od-vH1Gmf-ibnC6b div, .VIpgJd-ZVi9od-vH1Gmf-ibnC6b:link div, .VIpgJd-ZVi9od-vH1Gmf-ibnC6b:visited div, .VIpgJd-ZVi9od-vH1Gmf-ibnC6b:active div {
                        color: #fff;
                        background: transparent;
                        padding: 14px 8px;
                        -webkit-transition: all 0.2s;
                        transition: all 0.2s;
                    }
                    .VIpgJd-ZVi9od-vH1Gmf-ibnC6b:hover div {
                        color: #FFF;
                        background: #c1c1c17a;
                    }
                    a.VIpgJd-ZVi9od-vH1Gmf-ibnC6b-gk6SMd div span {
                        font-size: 12pt !important;
                        color:#fff
                    }
                    span.indicator {
                        margin-right: 8px;
                    }
            `;

            // Start checking for the element with a 1-second interval and a maximum of 10 attempts
            continuouslyCheckElement(iframeSelector, className, cssRules, 1000, 10);

        };

    </script>


    <script>


        var currencySymbols = {
            "USD": "$",
            "EUR": "€",
            "GBP": "£",
            "PLN": "zł",
            "DKK": "kr",
            "SEK": "kr",
            "NOK": "kr",
            "ANG": "ƒ",
            "ARS": "$",
            "AUD": "$",
            "BAM": "KM",
            "BGN": "лв",
            "CAD": "$",
            "CHF": "CHF",
            "CNY": "¥",
            "CZK": "Kč",
            "HRK": "kn",
            "HUF": "Ft",
            "RUB": "₽",
            "TRY": "₺"
            // Add more mappings as needed
        };




        // Function to update price symbols
        function updatePrices(selectedCurrency) {
            debugger;


            var symbol = currencySymbols[selectedCurrency == null?'EUR':selectedCurrency];
            $('.price').each(function () {
                var priceValue = $(this).attr('data-price');

                if (priceValue == undefined){

                    
                $(this).text(symbol);
                }
                else {


                    $(this).text(symbol + priceValue);
                }

            });
        }

        function SinglePriceListing(selectedCurrency) {
     
           
            var symbol = currencySymbols[selectedCurrency == null?'EUR':selectedCurrency];
            $('.pricesingle').each(function () {

                var span = $(this).find('.rtcl-price-currencySymbol');
                // Get the price value
                var priceValue = span.data('price');

                
                // Update the bdi content
                $(this).html(symbol + '<span class="rtcl-price-currencySymbol" data-price="' + priceValue + '">' + priceValue + '</span>');

            });
        }


        $(document).ready(function () {

            // Initialize currency and select options
            GetFooterAdvertisments();

            let storedCurrency = localStorage.getItem('cur');

            if (storedCurrency==null){
                localStorage.setItem('cur','EUR');
               storedCurrency =  localStorage.getItem('cur');
            }

            $("#currency").val(storedCurrency);
            $("#currency").niceSelect('destroy');
            $("#currency").niceSelect();
            $("#currency").change();
        });

        function GetFooterAdvertisments() {
            postRequest('/Advertisement/GetHomeAdvertisments/' + 3, null, function (res) {
                if (res.status == 200) {
                    if (res.data != null) {
                        if (res.data.length == 1) {
                            $.each(res.data, function (index, item) {
                                var html = `<img class="footerAdvertise" src="${baseApiUrl.value == undefined ? baseApiUrl + item.paidAdvertisments : baseApiUrl.value + item.paidAdvertisments}" alt="${item.alt}"/>`;
                                $('#appendFooterAdverts').append(html);
                            });
                            $(".footerAdvertise").show();
                        } else if (res.data.length > 1) {
                            $.each(res.data, function (index, item) {
                                var html = `<img class="footerAdvertise" src="${baseApiUrl.value == undefined ? baseApiUrl + item.paidAdvertisments : baseApiUrl.value + item.paidAdvertisments}" alt="${item.alt}"/>`;
                                $('#appendFooterAdverts').append(html);
                            });

                            var $images = $('.footerAdvertise'); // Get all images
                            var index = 0; // Initialize index

                            // Show the first image initially
                            $images.eq(index).show();

                            // Function to rotate images
                            function rotateImages() {
                                // Hide the current image
                                $images.eq(index).hide();

                                // Increment index or reset to 0 if it exceeds the number of images
                                index = (index + 1) % $images.length;

                                // Show the next image
                                $images.eq(index).show();
                            }

                            // Set interval to rotate images every X seconds
                            setInterval(rotateImages, 800);
                        }
                    }
                } else {
                    Swal.fire({
                        title: "Error",
                        text: res.responseMsg,
                        icon: res.status == 600 ? "warning" : "error"
                    });
                }
            });
        }

        $("#btnLogOFf").click(function () {
            postRequest("/Account/Logout", null, function (res) {
                if (res.status == 200) {
                    window.location.href = "/";
                }
            });
        });

        function postRequest(url, requestData, handledata) {
            $.ajax({
                type: 'POST',
                contentType: 'application/json;charset=utf-8',
                dataType: "json",
                url: url,
                data: JSON.stringify(requestData),
                success: function (data) {
                    handledata(data);
                },
                error: function () {
                    Swal.fire({
                        title: "Error",
                        text: "Something Went Wrong!",
                        icon: "error",
                        dangerMode: true,
                    });
                }
            });
        }

        function getQueryParams() {
            var params = {};
            var queryString = window.location.search.substring(1);
            var regex = /([^&=]+)=([^&]*)/g;
            var m;
            while (m = regex.exec(queryString)) {
                params[decodeURIComponent(m[1])] = decodeURIComponent(m[2]);
            }
            return params;
        }

        function updateQueryStringParameter(uri, key, value) {
            var re = new RegExp("([?&])" + key + "=.*?(&|$)", "i");
            var separator = uri.indexOf('?') !== -1 ? "&" : "?";
            if (uri.match(re)) {
                return uri.replace(re, '$1' + key + "=" + value + '$2');
            } else {
                return uri + separator + key + "=" + value;
            }
        }

        function updateCurrencyFlag() {
            const select = document.getElementById('currency');
            const niceSelect = $(select).siblings();
            const selectedOption = select.options[select.selectedIndex];
            const flag = selectedOption.getAttribute('data-flag');
            $(niceSelect).css({
                "background-image": `url(https://cdnjs.cloudflare.com/ajax/libs/flag-icon-css/6.6.6/flags/4x3/${flag}.svg)`,
                "background-repeat": "no-repeat",
                "background-position": "10px center",
                "background-size": "20px auto",
                "padding": "0px 40px"
            });
        }

        $("#currency").change(function () {
            updateCurrencyFlag();

            var newCurrency = $(this).val();
            var storedCurrency = localStorage.getItem('cur');

            if (newCurrency !== storedCurrency) {
                // Update local storage and URL
                localStorage.setItem('cur', newCurrency);
                var params = getQueryParams();
                if (params.hasOwnProperty('currency')) {
                    // Change the value of the "currency" parameter
                    params['currency'] = newCurrency;
                    var newUrl = updateQueryStringParameter(window.location.href, 'currency', params['currency']);
                } else {
                    // Add the "currency" parameter if it does not exist
                    var newUrl = window.location.href + (window.location.search ? '&' : '?') + 'currency=' + newCurrency;
                }
                history.replaceState(null, '', newUrl);

                // Reload the page to apply the new currency
                window.location.reload();
            }
        });


    </script>

