@using ClassLibrary.ViewModels
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration

 @model ListingForView;

<!-- Fancybox CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.min.css" />

<!-- jQuery (required by Fancybox) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Fancybox JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/fancybox/3.5.7/jquery.fancybox.min.js"></script>

<style>
   .listingDetails-header .page-header .photo-swip-gallery-wrap {
    display: grid;
    grid-gap: 8px;
    grid-template-columns: 1fr 1fr 1fr 1fr; /* Maintain 4 columns */
}

.page-header .photo-swip-gallery-wrap.items-five .listing-gallery-item:nth-child(1) {
    grid-column: 1 / 3;
    grid-row: 1 / 3;
    display: block;
}

.listing-gallery-item:nth-child(1)  {
    height: 450px !important;
}

.listing-gallery-item:nth-child(1) img {
    height: 450px !important;
    object-fit: cover;
}

.listing-gallery-item img {
    height: 225px !important;
    object-fit: cover;
}

.listingDetails-header .page-header .photo-swip-gallery-wrap .listing-gallery-item img {
    height: auto;
    max-width: 100%;
    border-radius: 8px;
}

/* Responsive adjustments */
@@media (max-width: 1200px) {
    .listing-gallery-item:nth-child(1) {
        height: 350px !important; /* Adjust height */
    }
    .listing-gallery-item img {
        height: 175px !important; /* Adjust height */
    }
}

@@media (max-width: 768px) {
    .listing-gallery-item:nth-child(1) {
        height: 300px !important; /* Adjust height */
    }
    .listing-gallery-item img {
        height: 150px !important; /* Adjust height */
    }
}

@@media (max-width: 480px) {
    .listing-gallery-item:nth-child(1) {
        height: 250px !important; /* Adjust height */
    }
    .listing-gallery-item img {
        height: 125px !important; /* Adjust height */
    }
}


    .listing-type-badge{
        height: 23px;
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        border-radius: 0;
        text-align: left;
        line-height: normal;
        letter-spacing: 0.44px;
        text-transform: uppercase;
        padding: 5px 20px 5px 10px;
        align-items: center;
        display: inline-flex;
        background-color: #02c5bd;
        -webkit-clip-path: polygon(0% 0%, 100% 0%, 90% 50%, 100% 100%, 0% 100%);
        clip-path: polygon(0% 0%, 100% 0%, 90% 50%, 100% 100%, 0% 100%);
    }

    .listing-details-head .listing-details-head-top .rtcl-listing-badge-wrap {
        flex-flow: unset;
    }

    .rtcl .rtcl-listing-badge-wrap {
        gap: 5px;
        margin: 0;
        flex-flow: column;
        display: inline-flex;
        align-items: flex-start;
    }

    .rtcl-listing-badge-wrap .badge.rtcl-badge-popular {
        background-color: #ff3d41;
    }

    .rtcl-listing-badge-wrap .badge {
        height: 23px;
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        border-radius: 0;
        text-align: left;
        line-height: normal;
        letter-spacing: 0.44px;
        text-transform: uppercase;
        padding: 5px 20px 5px 10px;
        align-items: center;
        display: inline-flex;
        background-color: #02c5bd;
        -webkit-clip-path: polygon(0% 0%, 100% 0%, 90% 50%, 100% 100%, 0% 100%);
        clip-path: polygon(0% 0%, 100% 0%, 90% 50%, 100% 100%, 0% 100%);
    }

    .rtcl-listing-badge-wrap .badge:before {
        content: '';
        font-family: "rt-petslist";
        font-weight: normal;
        display: inline-block;
        margin-right: 0.3em;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }

    .listing-details-head {
        border-radius: 10px;
        background-color: #FFF;
        border: 1px solid #E1E9E9;
        padding: 20px 30px 30px 30px;
        margin-bottom: 24px;
        margin-top: 24px;
    }

        .listing-details-head .title-price {
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .listing-details-head .title-price {
            gap: 30px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
        }

        .listing-details-head .rtcl-listing-title {
            margin: 0;
            font-size: 30px;
            font-weight: 600;
            text-transform: capitalize;
        }

        .listing-details-head .title-price .rtcl-price {
            color: red;
            font-size: 30px;
            font-weight: 600;
            line-height: 28px;
            text-transform: capitalize;
            font-family: var(--petslist-heading-font);
        }

        .listing-details-head .rtcl-listing-meta {
            gap: 10px;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
        }

    .listing-details-head .rtcl-listing-meta-data {
        margin-top: 0;
    }

    .rtcl-listing-meta-data {
        color: grey;
        display: flex;
        flex-wrap: wrap;
        font-size: 15px;
        list-style: none;
        margin: 5px 0 0;
        padding: 0;
    }

    .listing-details-head .rtcl-listing-meta-data li{
        margin-top: 0;
    }

    .rtcl .rtcl-listing-meta-data li {
        color: #515167;
        font-size: 14px;
        font-weight: 500;
        line-height: normal;
        margin-top: 7px;
    }

    .rtcl-listing-meta-data li {
        color: #646464;
        margin-bottom: 5px;
        margin-left: 0;
        margin-right: 10px;
    }

        .rtcl-listing-meta-data li i {
            color: #9E9FB2;
            margin-right: 3px;
            font-size: 18px;
            position: relative;
            top: 4px;
        }

    .rtcl-single-listing-details, .listing-details-head {
        border-radius: 10px;
        background-color: #FFF;
        border: 1px solid #E1E9E9;
        padding: 20px 30px 30px 30px;
        margin-bottom: 24px;
    }

        .rtcl-single-listing-details .rtcl-main-content-wrapper {
            padding: 0;
            position: relative;
        }

    .accordion-flush .accordion-item:last-child {
        border-bottom: 0;
    }

    .rtcl-single-listing-details .accordion .accordion-item .accordion-header {
        margin-bottom: 15px;
    }

        .rtcl-single-listing-details .accordion .accordion-item .accordion-header .accordion-button:not(.collapsed) {
            background-color: transparent;
            -webkit-box-shadow: none;
            box-shadow: none;
        }

        .rtcl-single-listing-details .accordion .accordion-item .accordion-header .accordion-button::before {
            content: "";
            position: absolute;
            left: 0;
            bottom: 0;
            width: 30px;
            height: 4px;
            border-radius: 100px;
            background-color: #02c5bd;
            top: 54px;
        }

        .rtcl-single-listing-details .accordion .accordion-item .accordion-header .accordion-button {
            color: #070c3e;
            font-size: 24px;
            font-weight: 600;
            text-transform: capitalize;
            line-height: normal;
            padding: 0 0 6px 0;
        }

    .rtcl-listing-description {
        font-size: 16px;
    }

    .rtcl p {
        color: #7a7c93;
    }

    .rtcl-single-listing-details .custom-field-wrapper {
        margin: 0;
        width: 100%;
        margin-top: 15px;
        display: inline-block;
    }

        .rtcl-single-listing-details .custom-field-wrapper .list-group-item:nth-child(odd) {
            margin-right: 15px;
        }

        .rtcl-single-listing-details .custom-field-wrapper .list-group-item .cfp-label {
            width: 100px;
            font-size: 14px;
            font-weight: 500;
            color: #515167;
            display: inline-block;
        }

        .rtcl-single-listing-details .custom-field-wrapper .list-group-item .cfp-label {
            width: 100px;
            font-size: 14px;
            font-weight: 500;
            color: #515167;
            display: inline-block;
        }

        .rtcl-single-listing-details .custom-field-wrapper .list-group-item .cfp-value {
            font-size: 16px;
            font-weight: 500;
            line-height: 27px;
            text-transform: capitalize;
            color: #000 !important;
        }

        .rtcl-single-listing-details .custom-field-wrapper .list-group-item:nth-child(1), .rtcl-single-listing-details .custom-field-wrapper .list-group-item:nth-child(2), .rtcl-single-listing-details .custom-field-wrapper .list-group-item:nth-child(5), .rtcl-single-listing-details .custom-field-wrapper .list-group-item:nth-child(6), .rtcl-single-listing-details .custom-field-wrapper .list-group-item:nth-child(9), .rtcl-single-listing-details .custom-field-wrapper .list-group-item:nth-child(10), .rtcl-single-listing-details .custom-field-wrapper .list-group-item:nth-child(13), .rtcl-single-listing-details .custom-field-wrapper .list-group-item:nth-child(14), .rtcl-single-listing-details .custom-field-wrapper .list-group-item:nth-child(17), .rtcl-single-listing-details .custom-field-wrapper .list-group-item:nth-child(18) {
            background-color: #F7F7F7;
        }

        .rtcl-single-listing-details .custom-field-wrapper .list-group-item {
            border: none;
            width: 48%;
            float: left;
            border-radius: 4px;
        }

    .center-card {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .button-group {
        display: flex;
        justify-content: space-around;
        width: 100%;
    }

    .flex-button {
        flex: 1;
        margin: 0 10px;
    }
        /* Dynamic button colors */
        .flex-button:nth-child(1) {
            background-color: #676767;
            color: #fff;
        }

        .flex-button:nth-child(2) {
            background-color: #dc3545;
            color: #fff;
        }

        .flex-button:nth-child(3) {
            background-color: #ffc107;
            color: #fff;
        }

        .flex-button:nth-child(4) {
            background-color: #28a745;
            color: #fff;
        }

</style>

 <!--====== Start breadcrumbs Section ======-->
<section class=" d-none page-breadcrumbs page-breadcrumbs-two bg_cover" style="background-image: url('https://t4.ftcdn.net/jpg/02/35/26/51/360_F_235265169_iZnBkQhBM1yVs6adbpB1pq2dlQVoFxLn.jpg');"></section>
<!--====== End breadcrumbs Section ======-->
<!--====== Start Listing Details Section ======-->
<section class="listing-details-section pt-40 pb-90">
    <div class="container">
        @if(@Model.data != null)
        {
            @if (@Model.status == 200 && @Model.data.Listing != null)
            {
                <div class="row mt-20">
                    @if (@Model.data.Listing != null)
                    {

                    }
                    
                    <div class="col-12">

                        <h2 class="title pb-40 d-none" style="font-family: 'Quicksand', sans-serif;">@Model.data.Listing.Title</h2>
                        <div class="listingDetails-header">
                            <div class="page-header">
                                <div class="photo-swip-gallery-wrap items-five">
                                    @{
                                        if (!string.IsNullOrWhiteSpace(@Model.data.Listing.VideoPath))
                                        {
                                            <!-- Show the Video if Available With Feature Image Thumbnail-->

                                            <div class="listing-gallery-item photoswip-item image-size-rtcl-thumbnail item-1">

                                                <div class="listing-play-box wow fadeInUp" style="height:100%; visibility: visible; animation-name: fadeInUp;">
                                                    <div class="play-content bg_cover text-center d-flex align-items-center justify-content-center h-100" style="border-radius:8px; background-image: url('@Configuration.GetSection("UrlSetting").GetSection("baseApiUrl").Value@Model.data.Listing.FeatureImagePath.Replace("\\", "/")');">
                                                        <a href="@Configuration.GetSection("UrlSetting").GetSection("baseApiUrl").Value@Model.data.Listing.VideoPath.Replace("\\", "/")" target="_blank" class="video-popup"><i class="flaticon-play-button"></i></a>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                        else{
                                            <!-- Show the feature image -->
                                        <div class="listing-gallery-item photoswip-item image-size-rtcl-thumbnail item-1">
                                            <a class="listing-popup-btn" data-fancybox="gallery" href="@Configuration.GetSection("UrlSetting").GetSection("baseApiUrl").Value@Model.data.Listing.FeatureImagePath">
                                                <img loading="lazy" src="@Configuration.GetSection("UrlSetting").GetSection("baseApiUrl").Value@Model.data.Listing.FeatureImagePath" class="attachment-rtcl-thumbnail size-rtcl-thumbnail" alt="" decoding="async" title="">
                                            </a>
                                        </div>
                                        }
                                    }
                                    

                                    <!-- Iterate over gallery images -->
                                    @if (!string.IsNullOrWhiteSpace(@Model.data.Listing.GallaryImagesPath))
                                    {
                                        @foreach (var imagePath in @Model.data.Listing.GallaryImagesPath.Replace(" ", "").Split(','))
                                        {
                                            <div class="listing-gallery-item photoswip-item image-size-rtcl-thumbnail">
                                                <a class="listing-popup-btn" data-fancybox="gallery" href="@Configuration.GetSection("UrlSetting").GetSection("baseApiUrl").Value@imagePath">
                                                    <img loading="lazy" src="@Configuration.GetSection("UrlSetting").GetSection("baseApiUrl").Value@imagePath" class="attachment-rtcl-thumbnail size-rtcl-thumbnail" alt="" decoding="async" title="">
                                                </a>
                                            </div>
                                        }
                                    }
                                </div>

                            </div>



                        </div>
                    </div>
                    <div class="col-lg-8">


                        @* Listing Title & Price *@
                        <div class="listing-details-head">
                            <div class="meta-info-box">
                                <div class="listing-details-head-top">
                                    <div class="listing-badge">
                                        <span class="listing-type-badge">
                                            @Model.data.Listing.CategoryName
                                        </span>
                                        <div class="rtcl-listing-badge-wrap d-none"><span class="badge rtcl-badge-popular popular-badge badge-success">Popular</span></div>
                                    </div>
                                </div>
                                <div class="title-price">
                                    <h2 class="rtcl-listing-title">
                                        @Model.data.Listing.Title
                                    </h2>
                                    <!-- Price -->
                                    <div class="rtcl-price-wrap price-in-mobile">
                                        <div class="rtcl-price price-type-fixed"><span class="rtcl-price-amount amount"><bdi class="pricesingle">£<span class="rtcl-price-currencySymbol" data-price='@Model.data.Listing.Price'>@Model.data.Listing.Price</span></bdi></span></div>
                                    </div>
                                </div>
                                <div class="meta-list">
                                    <!-- Meta data -->
                                    <div class="rtcl-listing-meta">
                                        <ul class="rtcl-listing-meta-data">
                                            <li class="author">
                                                <i class="flaticon-add-user"></i>
                                                by @Model.data.Listing.Username
                                            </li>
                                            <li class="rt-location">
                                                <i class="ti-location-pin"></i>
                                                <a href="">@Model.data.Listing.Location</a><span class="rtcl-delimiter">,</span> <a href="">@Model.data.Listing.City</a>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>


                       
                        <div class="listing-details-wrapper listing-details-wrapper-two">

                            @* Listing Video *@
                            @if (!string.IsNullOrWhiteSpace(@Model.data.Listing.VideoPath))
                            {
                                <div class="rtcl-single-listing-details video-box d-none">
                                    <div class="rtcl-main-content-wrapper">
                                        <div class="accordion accordion-flush" id="petslist-map-accordion">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header" id="flush-headingTwo">
                                                    <button class="accordion-button mb-20" type="button">
                                                        Video
                                                    </button>
                                                </h2>
                                                <div class="listing-play-box mb-30 wow fadeInUp" style="visibility: visible; animation-name: fadeInUp;">
                                                    <div class="play-content bg_cover text-center" style="background-image: url('@Configuration.GetSection("UrlSetting").GetSection("baseApiUrl").Value@Model.data.Listing.FeatureImagePath.Replace("\\", "/")');">
                                                        <a href="@Configuration.GetSection("UrlSetting").GetSection("baseApiUrl").Value@Model.data.Listing.VideoPath.Replace("\\", "/")" target="_blank" class="video-popup"><i class="flaticon-play-button"></i></a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* Listing Pedigree *@
                            @if (!string.IsNullOrWhiteSpace(@Model.data.Listing.PedigreeFilePath))
                            {
                                <div class="rtcl-single-listing-details video-box">
                                    <div class="rtcl-main-content-wrapper">
                                        <div class="accordion accordion-flush" id="petslist-map-accordion">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header" id="flush-headingTwo">
                                                    <button class="accordion-button mb-20" type="button">
                                                        Pedigree
                                                    </button>
                                                </h2>
                                                <div class="listing-gallery-item photoswip-item image-size-rtcl-thumbnail">
                                                    <a class="listing-popup-btn" data-fancybox="gallery" href="@Configuration.GetSection("UrlSetting").GetSection("baseApiUrl").Value@Model.data.Listing.PedigreeFilePath">
                                                        <img loading="lazy" height="500" style="object-fit:cover;" src="@Configuration.GetSection("UrlSetting").GetSection("baseApiUrl").Value@Model.data.Listing.PedigreeFilePath" class="attachment-rtcl-thumbnail size-rtcl-thumbnail" alt="" decoding="async" title="">
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }


                            @* Listing Details *@
                            <div class="rtcl-single-listing-details custom-fields-box">
                                <div class="rtcl-main-content-wrapper">
                                    <div class="accordion accordion-flush" id="petslist-content-accordion">
                                        <div class="accordion-item">
                                            <h2 class="accordion-header" id="flush-headingOne">
                                                <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
                                                    Details
                                                </button>
                                            </h2>
                                            <div id="flush-collapseOne" class="accordion-collapse collapse show" aria-labelledby="flush-headingOne" data-bs-parent="#petslist-content-accordion">
                                                <!-- Description -->
                                                <div class="rtcl-listing-description">
                                                    <p>@Model.data.Listing.Description</p>
                                                </div>


                                                <!--  Inner Sidebar -->
                                                <ul class="list-group custom-field-wrapper">

                                                    <li class="list-group-item rtcl-field-text rtcl-field-slug-name">
                                                        <span class="cfp-label">
                                                            <span>Name:</span>
                                                        </span>
                                                        <span class="cfp-value">
                                                            @Model.data.Listing.Title
                                                        </span>
                                                    </li>
                                                    <li class="list-group-item rtcl-field-text rtcl-field-slug-color">
                                                        <span class="cfp-label">
                                                            <span>Color:</span>
                                                        </span>
                                                        <span class="cfp-value">
                                                            @Model.data.Listing.Color
                                                        </span>
                                                    </li>
                                                    <li class="list-group-item rtcl-field-radio rtcl-field-slug-isCastration">
                                                        <span class="cfp-label">
                                                            <span>Castration:</span>
                                                        </span>
                                                        <span class="cfp-value">
                                                            @(Model.data.Listing.IsCastration ? "Yes" : "No")
                                                        </span>
                                                    </li>
                                                    <li class="list-group-item rtcl-field-text rtcl-field-slug-weight">
                                                        <span class="cfp-label">
                                                            <span>Sterilization:</span>
                                                        </span>
                                                        <span class="cfp-value">
                                                            @(Model.data.Listing.IsSterilization ? "Yes" : "No")
                                                        </span>
                                                    </li>
                                                    <li class="list-group-item rtcl-field-radio rtcl-field-slug-gender">
                                                        <span class="cfp-label">
                                                            <span>Gender:</span>
                                                        </span>
                                                        <span class="cfp-value">
                                                            @Model.data.Listing.Gender
                                                        </span>
                                                    </li>
                                                    <li class="list-group-item rtcl-field-radio rtcl-field-slug-age">
                                                        <span class="cfp-label">
                                                            <span>Age:</span>
                                                        </span>
                                                        <span class="cfp-value">
                                                            @Model.data.Listing.Age
                                                        </span>
                                                    </li>
                                                    <li class="list-group-item rtcl-field-radio rtcl-field-slug-age">
                                                        <span class="cfp-label">
                                                            <span>Type of Cat:</span>
                                                        </span>
                                                        <span class="cfp-value">
                                                            @Model.data.Listing.CatType
                                                        </span>
                                                    </li>
                                                    <li class="list-group-item rtcl-field-radio rtcl-field-slug-age">
                                                        <span class="cfp-label">
                                                            <span>Cattery :</span>
                                                        </span>
                                                        <span class="cfp-value">
                                                            @Model.data.Listing.CatteryName
                                                        </span>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>


                           
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="sidebar-widget-area">
                            
                            <div class="widget contact-info-widget mb-30 wow fadeInUp" style="margin-top:28px">
                               
                                <div class="contact-info-widget-wrap">
                                    <div class="contact-info-content pt-0">
                                        <img loading="lazy" style="width:150px;aspect-ratio:1;border-radius:50%" src="@Configuration.GetSection("UrlSetting").GetSection("baseApiUrl").Value@Model.data.Listing.ProfilePicPath" class="attachment-rtcl-thumbnail size-rtcl-thumbnail" alt="" decoding="async" title="">
                                        <h4 class="widget-title">Contact Info</h4>
                                        <div class="info-list">
                                            @if (!string.IsNullOrWhiteSpace(@Model.data.Listing.Username))
                                            {
                                                <p><i class="ti-user"></i><a href="javascript:void(0)">@Model.data.Listing.Username</a></p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(@Model.data.Listing.ContactNo))
                                            {
                                                <p><i class="ti-tablet"></i><a href="tel:@Model.data.Listing.ContactNo">@Model.data.Listing.ContactNo</a></p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(@Model.data.Listing.Email))
                                            {
                                                <p><i class="ti-email"></i><a href="mailto:@Model.data.Listing.Email">@Model.data.Listing.Email</a></p>
                                            }
                                        </div>
                                        <ul class="social-link d-none">
                                            <li><a href="#"><i class="ti-facebook"></i></a></li>
                                            <li><a href="#"><i class="ti-twitter-alt"></i></a></li>
                                            <li><a href="#"><i class="ti-pinterest"></i></a></li>
                                            <li><a href="#"><i class="ti-dribbble"></i></a></li>
                                        </ul>
                                    </div>
                                    <div class="contact-map mt-5">
                                        <iframe src="https://maps.google.com/maps?q=new%20york&t=&z=13&ie=UTF8&iwloc=&output=embed"></iframe>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            else if (@Model.data.Package != null)
            {

                <div class="container">
                    <div class="row center-card">
                        <div class="col-md-6">
                            <div class="card text-center shadow">
                                <div class="card-header">
                                    <h3> Choose Your Plan</h3>
                                </div>
                                <div class="card-body py-5">
                                    <div class="button-group">
                                        @foreach (var item in Model.data.Package)
                                        {
                                            <button type="button" class="btn flex-button btnChoosePkg" data-id="@item.PackageID">@item.Name</button>


                                        }
                                    </div>
                                </div>
                                <div class="card-footer">
                                    <p class="card-text">Choose a package to view pedigree listings. Once selected, you'll be able to see pedigree listings for the next 60 days. Note that this will deduct one listing from your chosen package.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row mt-140 d-none">
                    <div class="col-lg-12">
                        <h2 class="text-center mt-5">Select your package from which remaining listing will be Deducted</h2>
                    </div>
                    <div class="col-md-12 mt-20">


                        @foreach (var item in Model.data.Package)
                        {

                            <div class="single-checkbox d-flex">
                                <input type="radio" class="selectpackage" id="showpromotionpackage_@item.PackageID" data-id="@item.PackageID" name="showpromotionpackage" value="@item.PackageID">
                                <label for="showpromotionpackage_@item.PackageID" class="mb-5"><strong style=" color: #ff344f; font-size: 18px; ">@item.Name</strong></label>
                            </div>


                        }

                    </div>

                    <button type="button" class="btn btn-primary" id="choosepackage">Select package</button>
                </div>
            }

            else
            {
                <div class="row mt-140">
                    <div class="col-lg-12">
                        <h2 class="text-center mt-5">Please Login/Buy a plan to View Pedigree Listings</h2>
                    </div>
                    <div class="col-md-12 mt-20">
                        <div class="cta-content-box fadeInRight text-center">
                            <a href="/Packages/Pricing" class="main-btn icon-btn text-center">Buy Package</a>
                        </div>
                    </div>
                </div>
            }
        }

        else
        {
            <div class="row mt-140">
                <div class="col-lg-12">
                    <h2 class="text-center mt-5">Please Login/Buy a plan to View Pedigree Listings</h2>
                </div>
                <div class="col-md-12 mt-20">
                    <div class="cta-content-box fadeInRight text-center">
                        <a href="/Packages/Pricing" class="main-btn icon-btn text-center">Buy Package</a>
                    </div>
                </div>
            </div>
        }

      

    </div>
</section><!--====== End Listing Details Section ======-->


