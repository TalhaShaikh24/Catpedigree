<section class="listing-list-area pt-120 pb-90">
    <div class="three-column-container">
        <div class="ad-sidebar ad-left">
            <div class="sidebar-widget-area pr-lg-4">
                <div class="widget search-listing-widget mb-30 wow fadeInUp">
                    <h4 class="widget-title">Filter Search</h4>
                    <form>
                        <div class="search-form">
                            <div class="form_group">
                                <input id="keywordFilter" type="search" class="form_control" placeholder="Search keyword" name="keywordFilter" required>
                                <i class="ti-search"></i>
                            </div>
                            <div class="form_group">
                                <select class="wide" id="categoryFilter">
                                    <option value="-1" selected disabled>Search Category</option>
                                    <option value="1">Pedigree</option>
                                    <option value="2">Studs</option>
                                    <option value="3">Relocation</option>
                                    <option value="4">Kittens For Sell</option>
                                </select>
                            </div>
                            <div class="form_group">
                                <select class="wide" id="breedFilter" placeholder="By breed" name="breedFilter">
                                    <option id="appendCatTypes" value="-1" selected disabled>Search Breed</option>
                                </select>
                            </div>
                            <div class="form_group">
                                <input type="text" id="locationFilter" class="form_control" placeholder="By Location" name="locationFilter">
                                <i class="ti-location-pin"></i>
                            </div>
                            <div class="form_group">
                                <input type="text" id="stateFilter" class="form_control" placeholder="By State" name="stateFilter">
                            </div>
                            <div class="form_group">
                                <input type="text" id="cityFilter" class="form_control" placeholder="By City" name="cityFilter">
                            </div>
                        </div>
                        <div class="price-range-widget d-none">
                            <h4 class="widget-title">By Price</h4>
                            <div id="slider-range" class="mb-20"></div>
                            <div class="price-number">
                                <span class="amount"><input type="text" id="amount"></span>
                            </div>
                        </div>
                        <div class="form_group">
                            <button type="button" id="btnApplyFilters" onclick="filteringSearch()" class="main-btn icon-btn">Search Now</button>
                        </div>
                        <div class="form_group">
                            <button type="button" onclick="window.location.href='/Listing/ViewListings'" class="main-btn btn-secondary icon-btn">Reset</button>
                        </div>
                    </form>
                </div>
                <div class="widget newsletter-widget mb-30 wow fadeInUp">
                    <h4 class="widget-title" style="font-weight:900">Advertisements</h4>

                    <div class="newsletter-widget-wrap bg_cover" id="leftAdvertisement-video-1">
                    </div>
                </div>
                <div class="widget newsletter-widget mb-30 wow fadeInUp">
                    <div class="newsletter-widget-wrap bg_cover">
                        <img id="leftAdvertisement-image-1" src="" alt="Advertisement">
                    </div>
                </div>
                <div class="widget newsletter-widget mb-30 wow fadeInUp">
                    <div class="newsletter-widget-wrap bg_cover">
                        <img id="leftAdvertisement-image-2" src="" alt="Advertisement">
                    </div>
                </div>
                <div class="widget newsletter-widget mb-30 wow fadeInUp">
                    <div class="newsletter-widget-wrap bg_cover">
                        <img id="leftAdvertisement-image-3" src="" alt="Advertisement">
                    </div>
                </div>
                <div class="widget newsletter-widget mb-30 wow fadeInUp">
                    <div class="newsletter-widget-wrap bg_cover" id="leftAdvertisement-video-2">
                    </div>
                </div>

            </div>
        </div>
        <div class="main-content">
            <div class="listing-search-filter mb-40">
                <div id="skeleton-loader" class="row" style="display: none; row-gap:26px">
                    <div class="col-lg-4 skeleton-item">
                        <div class="skeleton-content"></div>
                    </div>
                    <div class="col-lg-4 skeleton-item">
                        <div class="skeleton-content"></div>
                    </div>
                    <div class="col-lg-4 skeleton-item">
                        <div class="skeleton-content"></div>
                    </div>
                    <div class="col-lg-4 skeleton-item">
                        <div class="skeleton-content"></div>
                    </div>
                    <div class="col-lg-4 skeleton-item">
                        <div class="skeleton-content m-2"></div>
                    </div>
                    <div class="col-lg-4 skeleton-item">
                        <div class="skeleton-content"></div>
                    </div>
                    <!-- Add more skeleton items as needed -->
                </div>


                <div class="row" id="appendListings">
                </div>
            </div>
            <div class="button text-center mt-30">
                <a id="load-more" style="display:none" onclick="loadMore()" class="main-btn icon-btn">Load More</a>
            </div>
        </div>
        <div class="ad-sidebar ad-right">
            <div class="sidebar-widget-area">

                <div class="widget newsletter-widget mb-30 wow fadeInUp">
                    <h4 class="widget-title" style="font-weight:900">Advertisements</h4>
                    <div class="newsletter-widget-wrap bg_cover">
                        <img id="rigtAdvertisement-image-1" src="" alt="Advertisement">

                    </div>
                </div>
                <div class="widget newsletter-widget mb-30 wow fadeInUp">
                    <div class="newsletter-widget-wrap bg_cover">
                        <img id="rigtAdvertisement-image-2" src="" alt="Advertisement">

                    </div>
                </div>
                <div class="widget newsletter-widget mb-30 wow fadeInUp">
                    <div class="newsletter-widget-wrap bg_cover">
                        <img id="rigtAdvertisement-image-3" src="" alt="Advertisement">

                    </div>
                </div>
                <div class="widget newsletter-widget mb-30 wow fadeInUp">
                    <div class="newsletter-widget-wrap bg_cover">
                        <img id="rigtAdvertisement-image-4" src="" alt="Advertisement">

                    </div>
                </div>
                <div class="widget newsletter-widget mb-30 wow fadeInUp">
                    <div class="newsletter-widget-wrap bg_cover">
                        <img id="rigtAdvertisement-image-5" src="" alt="Advertisement">

                    </div>
                </div>

            </div>
        </div>
    </div>
   
</section>
