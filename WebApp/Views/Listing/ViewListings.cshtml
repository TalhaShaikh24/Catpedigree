<style>
    .newsletter-widget-wrap video{
        width:100%;
    }
    .three-column-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
}

.ad-sidebar {
    background-color: #f4f4f4;
    padding: 20px;
    flex: 1;
    min-width: 250px;
    max-width: 300px;
    margin: 10px;
}

.main-content {
    background-color: #fff;
    padding: 20px;
    flex: 2;
    min-width: 400px;
    max-width: 800px;
    margin: 10px;
}

@@media (max-width: 768px) {
    .three-column-container {
        flex-direction: column;
    }

    .ad-sidebar, .main-content {
        width: 100%;
    }
    .ad-sidebar{
        min-width: unset;
        max-width: unset;
        margin: 0px;
    }

