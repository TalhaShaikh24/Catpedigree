<div id="listing-container"></div>
<div id="count-display"></div>
<!--====== Start Map Section ======-->
<section class="map-area">
    <div class="map-box">
        <iframe src="https://maps.google.com/maps?q=new%20york&t=&z=13&ie=UTF8&iwloc=&output=embed"></iframe>
    </div>

</section><!--====== End Map Section ======-->
<!--====== Start Listing Section ======-->
<section class="listing-list-area pt-120 pb-90">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div class="sidebar-widget-area">
                    <div class="widget search-listing-widget mb-30 wow fadeInUp">
                        <h4 class="widget-title">Filter Search</h4>
                        <form>
                            <div class="search-form">
                                <div class="form_group">
                                    <input id="keywordFilter" type="search" class="form_control" placeholder="Search keyword" name="keywordFilter" required>
                                    <i class="ti-search"></i>
                                </div>
                                <div class="form_group">
                                    <select class="wide" id="categoryFilter">
                                        <option value="-1" selected disabled>Search By Category</option>
                                        <option value="1">Pedigree</option>
                                        <option value="2">Studs</option>
                                        <option value="3">Relocation</option>
                                        <option value="4">Kittens To Sell</option>
                                    </select>
                                </div>
                                <div class="form_group">
                                    <select class="wide" id="breedFilter" placeholder="Search By breed" name="breedFilter">
                                        <option id="appendCatTypes" value="-1" selected disabled>Search By Breed (Cat Type)</option>
                                    </select>
                                </div>
                                <div class="form_group">
                                    <input type="text" id="locationFilter" class="form_control" placeholder="Search By Location" name="locationFilter">
                                    <i class="ti-location-pin"></i>
                                </div>
                                <div class="form_group">
                                    <input type="text" id="stateFilter" class="form_control" placeholder="By State" name="stateFilter">
                                </div>
                                <div class="form_group">
                                    <input type="text" id="cityFilter" class="form_control" placeholder="By City" name="cityFilter">
                                </div>
                            </div>
                            <div class="price-range-widget">
                                <h4 class="widget-title">Search by Price</h4>
                                <div id="slider-range" class="mb-20"></div>
                                <div class="price-number">
                                    <span class="amount"><input type="text" id="amount"></span>
                                </div>
                            </div>
                            <div class="form_group">
                                <button type="button" id="btnApplyFilters" onclick="filteringSearch()" class="main-btn icon-btn">Search Now</button>
                            </div>
                            <div class="form_group">
                                <button type="button" onclick="window.location.href='/Listing/ViewListings'" class="main-btn btn-secondary icon-btn">Reset</button>
                            </div>
                        </form>
                    </div>
                    <div class="widget newsletter-widget mb-30 wow fadeInUp">
                        <div class="newsletter-widget-wrap bg_cover" style="background-image: url(assets/images/newsletter-widget-1.jpg);">
                            <i class="flaticon-email-1"></i>
                            <h3>
                                Place Your Ad Here
                            </h3>
                            <a href="/PromotionPackage/" class="main-btn icon-btn">Place Ad</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="listing-list-wrapper">
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="listing-search-filter mb-40">
                                <div class="row" id="appendListings">
                                </div>
                            </div>
                            <div class="button text-center mt-30">
                                <a id="load-more" style="display:none"  onclick="loadMore()" class="main-btn icon-btn">Load More</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--====== End Listing Section ======-->



<script src="~/webassets/pagesjs/viewlistings.js"></script>
