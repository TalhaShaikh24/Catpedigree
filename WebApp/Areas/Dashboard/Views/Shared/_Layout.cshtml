@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor Accessor
@using Newtonsoft.Json;
@using Newtonsoft.Json.Linq;
@using ClassLibrary

@functions {
    public string IsMenuItemActive(string controller, string action)
    {
        string currentController = ViewContext.RouteData.Values["controller"] as string;
        string currentAction = ViewContext.RouteData.Values["action"] as string;

        return (currentController == controller && currentAction == action) ? "active open" : "";
    }
}
 

@{
    string userJson = JsonConvert.SerializeObject(@Accessor.HttpContext.Request.Cookies["user"]);
    var userinfo = new Register();

    if (@Accessor.HttpContext.Request.Cookies["authorization"] != null && userJson != null)
    {

        // Check if userJson starts and ends with quotes and remove them if necessary
        if (userJson.StartsWith("\"") && userJson.EndsWith("\""))
        {
            userJson = userJson.Substring(1, userJson.Length - 2);
        }

        // Replace escaped quotes if any
        userJson = userJson.Replace("\\\"", "\"");

        // Parse the outer JSON object
        var outerObject = JObject.Parse(userJson);

        // Extract the 'dataObj' inner JSON string
        var dataObjJson = outerObject["dataObj"].ToString();

        // Deserialize the inner JSON string to the Register object
        userinfo = JsonConvert.DeserializeObject<Register>(dataObjJson);
}
}

