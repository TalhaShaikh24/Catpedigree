    <script>
        var $badge = $('#CommentsCount');
        function blinkBadge() {
            var $badge = $('#CommentsCount');
            var blinkInterval = setInterval(function () {
                $badge.toggleClass('hidden'); // Toggle the 'hidden' class
            }, 500); // Toggle every 500ms (adjust as needed)
        }


        $(document).ready(function(){
            GetAllUnreadComments();
            
        })

        function GetAllUnreadComments() {
            postRequest('/Dashboard/GetAllUnreadComments/',null, function (res) {

                debugger;
                if (res.status == 200) {

                    if (res.data[0].unreadComments > 0) {

                        $("#CommentsCount").text(res.data[0].unreadComments);
                        blinkBadge();

                    }
                }
                if (res.status == 304) {

                    Swal.fire({
                        title: "Error",
                        text: res.responseMsg,
                        icon: "error"
                    })
                }
                if (res.status == 305) {

                    Swal.fire({
                        title: "Error",
                        text: res.responseMsg,
                        icon: "error"
                    })
                }
                if (res.status == 401) {

                    Swal.fire({
                        title: "Error",
                        text: res.responseMsg,
                        icon: "error"
                    })
                }
                if (res.status == 403) {

                    Swal.fire(res.responseMsg, {
                        icon: "error",
                        title: "Error"
                    });
                }
                if (res.status == 320) {

                    Swal.fire({
                        title: "Error",
                        text: res.responseMsg,
                        icon: "error"
                    })
                }
                if (res.status == 500) {

                    Swal.fire({
                        title: "Error",
                        text: res.responseMsg,
                        icon: "error"
                    })
                }
                if (res.status == 600) {

                    Swal.fire({
                        title: "Warning",
                        text: res.responseMsg,
                        icon: "warning"
                    })

                }
            });
        }

        
    </script>



    <script>


        var RoleIds = '@roles';
    
        var currencySymbols = {
            "USD": "$",
            "EUR": "€",
            "GBP": "£"
            // Add more mappings as needed
        };



        // Function to update price symbols
        function updatePrices(selectedCurrency) {
            debugger;


            var symbol = currencySymbols[selectedCurrency == null ? 'EUR' : selectedCurrency];
            $('.price').each(function () {
                var priceValue = $(this).attr('data-price');

                if (priceValue == undefined) {


                    $(this).text(symbol);
                }
                else {


                    $(this).text(symbol + priceValue);
                }

            });
        }

        function SinglePriceListing(selectedCurrency) {
            debugger;
            var symbol = currencySymbols[selectedCurrency == null ? 'EUR' : selectedCurrency];
            $('.price').each(function () {

                var span = $(this).find('.rtcl-price-currencySymbol');
                // Get the price value
                var priceValue = span.data('price');

                if (priceValue == undefined) {

                        
                    $(this).text(symbol);
                }
                else {


                    // Update the bdi content
                    $(this).html(symbol + '<span class="rtcl-price-currencySymbol" data-price="' + priceValue + '">' + priceValue + '</span>');

                }

              
            });
        }


        $("#btnLogOFf").click(function () {


            postRequest("/Account/Logout", null, function (res) {

                if (res.status == 200) {

                    window.location.href = "/";
                }

            });
        });

        function postRequest(url, requestData, handledata) {

            $.ajax({
                type: 'POST',
                contentType: 'application/json;charset=utf-8',
                dataType: "json",
                url: url,
                headers: {

                },

                data: JSON.stringify(requestData),
                success: function (data, textstatus, xhr) {
                    handledata(data);
                },
                error: function (xhr, textstatus, errorThrown) {
                    swal({
                        title: "Error",
                        text: "Something Went Wrong!",
                        icon: "error",
                        dangerMode: true,
                    })
                }
            });
        }

        function ShowPreloader() {
            $('#preloader').css({
                "height": "100vh",
                "display": "flex"  // assuming you want the preloader to be displayed as a flex container
            });
            $('#preloader img').css({
                "display": "block"
            });
        }

        function HidePreloader() {
            $('#preloader').css({
                "height": "0vh",
                "display": "none"  // hide the preloader container
            });
            $('#preloader img').css({
                "display": "none"
            });
        }


    </script>
