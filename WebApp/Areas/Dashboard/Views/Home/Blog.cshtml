@{
    ViewData["Breadcrumb"] = "Manage Blogs";
}
<style>

    .form-control {
        height: calc(2.25rem + 7px)!important;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        background-color: #ef314c;
        border: 1px solid #ef314c;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
        color: white;
    }

    .select2-container--default.select2-container--focus .select2-selection--multiple {
        border: solid #ced4da 1px;
        outline: 0;
    }


</style>


<div class="row">
    
    <div class="col-md-12 mb-3">

        <div class="card card-primary p-0 m-0">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><b>Add Blog</b></h3>
                <button class="btn btn-success" id="Btn_BlogSubmit" style="margin-left: auto;">Submit</button>
            </div>
            <div class="card-body p-0 m-0">
                <div class="row p-3">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Title</label>
                            <input type="text" class="form-control" id="title" placeholder="Enter Title">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Category</label>
                            <select type="text" class="form-control" id="blogCategory" placeholder="Select Category">
                                <option></option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Short Description</label>
                            <textarea rows="4" style="height:auto!important; resize:vertical; overflow: auto;" class="form-control"  id="shortdescription" placeholder="Enter Short Description"></textarea>
                        </div>
                    </div> 
                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Tags</label>
                            <select class="form-control"  id="blogTags" placeholder="Enter Tags" multiple>
                                <option></option>
                            </select>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="d-block">Upload Featured Image</label>
                            <input type="file" class="form-control" id="featuredFile">
                            
                        </div>
                    </div>

                </div>
                <textarea id="summernote"></textarea>
            </div>
        </div>
    </div>
</div>





@section Scripts {

  <script src="~/dashboard/blog.js"></script>
}
