@{
    ViewData["Title"] = "Home Page";
}

<div class="row">
    <div class="col-lg-3 col-6">
        <!-- small box -->
        <div class="small-box bg-info">
            <div class="inner">
                <h3 id="TotalListingText">0</h3>
                <b>Total Listing</b>
            </div>
            <div class="icon">
                <i class="ion ion-bag"></i>
            </div>
          
        </div>
    </div>
    <!-- ./col -->
    <div class="col-lg-3 col-6">
        <!-- small box -->
        <div class="small-box bg-info">
            <div class="inner">
                <h3 id="ActiveListingText">0</h3>
                <b>Active Listing</b>
            </div>
            <div class="icon">
                <i class="ion ion-stats-bars"></i>
            </div>
           
        </div>
    </div>
    <!-- ./col -->
    <div class="col-lg-3 col-6">
        <!-- small box -->
        <div class="small-box bg-info">
            <div class="inner">
                <h3 id="ExpiredListingText">0</h3>
                <b>Expired Listing</b>
            </div>
            <div class="icon">
                <i class="ion ion-person-add"></i>
            </div>
           
        </div>
    </div>
    <!-- ./col -->
    <div class="col-lg-3 col-6">
        <!-- small box -->
        <div class="small-box bg-info">
            <div class="inner">
                <h3 id="PendingListingText">0</h3>
                <b>Pending Listing</b>
            </div>
            <div class="icon">
                <i class="ion ion-pie-graph"></i>
            </div>
            
        </div>
    </div>
    
    <div class="col-lg-3 col-6">
        <!-- small box -->
        <div class="small-box bg-info">
            <div class="inner">
                <h3 id="ApprovedListingText">0</h3>
                <b>Approved Listing</b>
            </div>
            <div class="icon">
                <i class="ion ion-pie-graph"></i>
            </div>
            
        </div>
    </div>  
    
    <div class="col-lg-3 col-6">
        <!-- small box -->
        <div class="small-box bg-info">
            <div class="inner">
                <h3 id="RejectedListingText">0</h3>
                <b>Rejected Listing</b>
            </div>
            <div class="icon">
                <i class="ion ion-pie-graph"></i>
            </div>
            
        </div>
    </div>


    <div class="col-lg-3 col-6">
        <!-- small box -->
        <div class="small-box bg-info">
            <div class="inner">
                <h3 id="ActivePlanText">0</h3>
                <b>Active Plan</b>
            </div>
            <div class="icon">
                <i class="ion ion-pie-graph"></i>
            </div>

        </div>
    </div>    
    
    <div class="col-lg-3 col-6">
        <!-- small box -->
        <div class="small-box bg-info">
            <div class="inner">
                <h3 id="ExpiredPlanText">0</h3>
                <b>Expired Plan</b>
            </div>
            <div class="icon">
                <i class="ion ion-pie-graph"></i>
            </div>

        </div>
    </div>
    <!-- ./col -->
</div>


<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><b>My Packages</b></h3>
            </div>
            <!-- /.card-header -->
            <div class="card-body">
                <div id="example2_wrapper" class="dataTables_wrapper dt-bootstrap4">
                    <div class="row">
                        <div class="col-sm-12 col-md-6"></div>
                        <div class="col-sm-12 col-md-6"></div>
                    </div>
                    <div class="row">
                        <div class="col-sm-12">
                            <table id="TableMyPackages" class="table table-bordered table-hover dataTable dtr-inline">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>AllowedListings</th>
                                        <th>RemainingListings</th>
                                    </tr>
                                </thead>
                                <tbody id="AppendMyPackages">
                                   
                              
                                </tbody>
                              
                            </table>
                        </div>
                    </div>
                   
                </div>
            </div>
          
        </div>

    </div>
   
</div>



@section Scripts {
<script src="~/dashboard/dashoard.js"></script>
}
