<style>
    .table-bordered td, .table-bordered th {
        width: 12%;
    }
</style>

<section class="content pb-4 pt-4">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12 mb-3">

                <div class="card card-primary p-0 m-0">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h3 class="card-title"><b>Add Category</b></h3>
                        <button class="btn btn-success" id="Btn_BlogCategorySubmit" style="margin-left: auto;">Submit</button>
                    </div>
                    <div class="card-body p-0 m-0">
                        <form>
                            <div class="row p-3">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Category Name</label>
                                        <input type="text" class="form-control" id="categoryName" name="CategoryName" placeholder="Enter Category Name">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Description</label>
                                        <input type="text" class="form-control" id="description" name="description" placeholder="Enter Title">
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="card card-primary">
                    <div class="card-header">
                        <h3 class="card-title"><b>Blog Categories</b></h3>

                    </div>
                    <div class="card-body">
                        <table id="TableBlogCategories" class="table table-bordered" style="width:100%;">
                            <thead>
                                <tr>

                                    <th style="width:30%">Category</th>
                                    <th style="width:30%">Description</th>
                                    <th style="width:20%">Created On</th>
                                    <th style="width:20%">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="AppendCategories">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        


    </div>
</section>

<!-- Modal for Editing Blog Category -->

<div class="modal fade" id="editCategoryModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title"><b>Update Blog Category</b></h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">

                <form id="editCategoryForm">
                    <div class="mb-3">
                        <label for="modalCategoryName" class="form-label">Category Name</label>
                        <input type="text" class="form-control" id="modalCategoryName" required>
                    </div>
                    <div class="mb-3">
                        <label for="modalDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="modalDescription" rows="3" required></textarea>
                    </div>
                    <input type="hidden" id="modalCategoryId">
                </form>
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button class="btn btn-success" type="button" id="Btn_Update_Listing">Update</button>
                <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
	<script src="~/dashboard/blogcategories.js"></script>
}
