
@{
    ViewData["Title"] = "CouponsList";
    Layout = "~/Areas/Dashboard/Views/Shared/_Layout.cshtml";
}


<div class="container-fluid">

    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title"><b>Coupens Codes</b></h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                    <i class="fas fa-minus"></i>
                </button>

            </div>
        </div>
        <div class="card-body">
            <table id="TableCoupensCodesListing" class="table table-bordered" style="width:100%;">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Discount Percentage</th>
                        <th>User Name</th>
                        <th>Days</th>

                        <th>IsActive</th>
                       
                        <th>IsExpire</th>

                        <th>Used By</th>


                        <th>Created On</th>
                        <th>Action</th>
                        
                    </tr>
                </thead>
                <tbody id="AppendCoupensCodesListing">
                </tbody>
            </table>
        </div>
    </div>


</div>




@section Scripts {

    <script src="~/dashboard/CoupensCodesList.js"></script>
}