@{
    ViewData["Title"] = "PromotionPackages";
}

<div class="row">

    <div class="col-md-12 mb-3">
        <div class="card card-primary p-0 m-0">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><b>Assign Pricing Packages</b></h3>

            </div>
           

             <form id="formid">
          
            <div class="card-body p-0 m-0">
                <div class="row p-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>User</label>
                            <select class="form-control" id="Users">
                            </select>

                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Pricing Packages</label>
                            <select class="form-control" id="Pricing">
                            </select>

                        </div>
                    </div>



                </div>


                <div class="row">
                    <div class="col-md-6">

                        <button type="button" class="btn btn-success m-3" id="save">Save</button>
                    </div>
                
                </div>

            </div>

            </form>
        </div>
    </div>



    <div class="col-md-12">

        <div class="container-fluid">

            <div class="card card-primary">
                <div class="card-header">
                    <h3 class="card-title"><b>My Listings</b></h3>
                    <div class="card-tools">
                        <button type="button" class="btn btn-tool" data-card-widget="collapse">
                            <i class="fas fa-minus"></i>
                        </button>

                    </div>
                </div>
                <div class="card-body table-responsive">
                    <table id="packagesAssignedtable" class="table table-bordered ">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>User Name</th>
                                <th>Email</th>
                                <th>ContactNo</th>
                                <th>Package Name</th>
                                <th>Package Price</th>

                            </tr>
                        </thead>
                        <tbody id="packagesAssigned">
                        </tbody>
                    </table>
                </div>
            </div>


        </div>


    </div>


</div>





@section Scripts {

    <script src="~/dashboard/AssignPricingPackage.js"></script>
}
