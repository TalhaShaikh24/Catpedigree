<section class="content pb-4 pt-4">
    <div class="container-fluid">

        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><b>Listings</b></h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>

                </div>
            </div>
            <div class="card-body">
                <table id="TableApprovalListing" class="table table-bordered table-responsive" style="width:100%;">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Title</th>
                            <th>Location</th>
                            <th>State</th>
                            <th>City</th>
                            <th>IsBreerderLicenseUpload</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>BreerderName</th>
                            <th>TypeOfCat</th>
                            <th>Gender</th>
                            <th>Description</th>
                            <th>Age</th>
                            <th>ZoologicalNumber</th>
                            <th>CategoryId</th>
                            <th>PackageId</th>
                            <th>IsActive</th>
                            <th>Status</th>
                            <th>CreatedBy</th>
                            <th>CreatedOn</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="AppendApprovalListing">
                    </tbody>
                </table>
            </div>
        </div>


    </div>
</section>

@section Scripts {
    <script src="~/dashboard/Listing.js"></script>
}

