<section class="content pb-4 pt-4">
    <div class="container-fluid">

        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><b>Listings</b></h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>

                </div>
            </div>
            <div class="card-body">
                <table id="TableApprovalListing" class="table table-bordered table-responsive">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Status</th>
                            <th>Title</th>
                            <th>Location</th>
                            <th>State</th>
                            <th>City</th>
                            <th>IsBreerderLicenseUpload</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>BreerderName</th>
                            <th>TypeOfCat</th>
                            <th>Gender</th>
                            <th>Age</th>
                            <th>ZoologicalNumber</th>
                            <th>CategoryId</th>
                            <th>PackageId</th> 
                            <th>Promotion  Package</th>
                            <th>IsActive</th>
                            <th>CreatedBy</th>
                            <th>CreatedOn</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="AppendApprovalListing">
                    </tbody>
                </table>
            </div>
        </div>


    </div>
    <!-- Bootstrap Modal -->
    <div class="modal fade" id="reasonModal" tabindex="-1" role="dialog" aria-labelledby="reasonModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reasonModalLabel">Enter Reason for Status Update</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <form id="reasonForm">
                        <div class="form-group">
                            <label for="reason">Reason:</label>
                            <textarea class="form-control" id="reason" rows="3" required></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" id="submitReason">Submit</button>
                </div>
            </div>
        </div>
    </div>


</section>

@section Scripts {
    <script src="~/dashboard/Listing.js"></script>
}

