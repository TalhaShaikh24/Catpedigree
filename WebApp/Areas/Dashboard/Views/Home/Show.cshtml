@{
    ViewData["Breadcrumb"] = "Manage Blogs";
}
<style>

    .form-control {
        height: calc(2.25rem + 7px) !important;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice {
        background-color: #ef314c;
        border: 1px solid #ef314c;
    }

    .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
        color: white;
    }

    .select2-container--default.select2-container--focus .select2-selection--multiple {
        border: solid #ced4da 1px;
        outline: 0;
    }

    .error {
        color: red;
        display: none;
    }
</style>


<div class="row">


    <div class="col-md-12 mb-3">

        <input id="ShowId"  value="0" type="hidden"/>

        <div class="card card-primary p-0 m-0">


            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><b>Add Show</b></h3>
                <button class="btn btn-success" type="button" id="Btn_BlogSubmit" style="margin-left: auto;">Submit</button>
            </div>
            <div class="card-body p-0 m-0">

                <div class="row p-3">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Title</label>
                                <input type="text" name="title" class="form-control" id="title" placeholder="Enter Title">

                            <span class="error" id="titleError">Please enter a title.</span>
                            </div>
                    </div>

  


                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="d-block">Upload Featured Image</label>
                            <input type="file" class="form-control" id="featuredFile">
                            <span class="error" id="fileError">Please select a file.</span>

                        </div>

                        <div class="row my-2" id="FeaturedImageAppend">
                        </div>
                    </div>
              
                </div>
                <textarea id="summernote"></textarea>


                <div class="col-md-6">
                    <div class="form_group">
                        <label class="d-block" style="line-height: 20px; font-weight:900">Other Listing Images (OPTIONAL)</label>

                        <div class="form_group">
                            <input type="file" multiple id="Gallery_Files" accept="image/*" class="form_control bg-white pt-4" style="opacity:1!important">
                        </div>
                    </div>

                    <div class="row" id="GalleryFilesAppend">
                    </div>
                </div>

            </div>

        </div>
    </div>

</div>





@section Scripts {

    <script src="~/dashboard/Show.js"></script>
}
