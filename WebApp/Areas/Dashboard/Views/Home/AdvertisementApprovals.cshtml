<style>
    .video-popup {
        width: 78px;
        height: 78px;
        border-radius: 50%;
        background-color: #ffd74e;
        color: #0d0d0d;
    }
</style>
<!-- Rejection Reason Modal -->
<div class="modal fade" id="rejectionReasonModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Rejection Reason</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <textarea id="rejectionReason" class="form-control" rows="3" placeholder="Please provide a reason for rejection..."></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="submitRejection">Reject</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="viewDetailsModal" tabindex="-1" aria-labelledby="viewDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewDetailsModalLabel">Advertisement Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <table class="table">
                    <tr>
                        <th>Package ID</th>
                        <td id="modalPackageId"></td>
                    </tr>
                    <tr>
                        <th id="lblImage">Image</th>
                        <td>
                            <img id="modalImage" src="" alt="Advertisement Image" style="max-width: 100px;" />
                            <video id="modalVideo" controls style="max-width: 100px; display: none;">
                                Your browser does not support the video tag.
                            </video>
                        </td>
                    </tr>
                    <tr id="trWidth">
                        <th>Original Width</th>
                        <td id="modalImageWidth"></td>
                    </tr>
                    <tr id="trHeight">
                        <th>Original Height</th>
                        <td id="modalImageHeight"></td>
                    </tr>
                    <tr>
                        <th>Package Name</th>
                        <td id="modalPackageName"></td>
                    </tr>
                    <tr>
                        <th>Package Cost</th>
                        <td id="modalPackageCost"></td>
                    </tr>
                    <tr>
                        <th>Package Type</th>
                        <td id="modalPackageType"></td>
                    </tr>
                    <tr>
                        <th>Number of Advertisements</th>
                        <td id="modalNumberOfAds"></td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td id="modalStatus"></td>
                    </tr>
                    <tr>
                        <th>Username</th>
                        <td id="modalUsername"></td>
                    </tr>
                    <tr>
                        <th>Created On</th>
                        <td id="modalCreatedOn"></td>
                    </tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" onclick="UpdateListingStatus(currentId, 'Approve');">Approve</button>
                <button type="button" class="btn btn-info" onclick="UpdateListingStatus(currentId, 'Pending');">Pending</button>
                <button type="button" class="btn btn-danger" onclick="openRejectionModal(currentId);">Reject</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<section class="content pb-4 pt-4">
    <div class="container-fluid">

        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><b>Listings</b></h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>

                </div>
            </div>
            <div class="card-body table-responsive">
                <table id="TableApprovalListing" class="table table-bordered" style="width:100%;">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Cost</th>
                            <th>Type</th>
                            <th>No. Of Advertisement</th>
                            <th>Status</th>
                            <th>User</th>
                            <th>CreatedOn</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="AppendApprovalListing">
                    </tbody>
                </table>
            </div>
        </div>


    </div>
</section>

@section Scripts {
    <script src="~/dashboard/AdvertisementGridList.js"></script>
}



