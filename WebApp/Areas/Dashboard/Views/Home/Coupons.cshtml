
@{
    ViewData["Title"] = "Coupons";
    Layout = "~/Areas/Dashboard/Views/Shared/_Layout.cshtml";
}




<section class="content pb-4 pt-4">
    <div class="container-fluid">

        <div class="card card-primary p-0 m-0">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><b>Coupons Codes</b></h3>

            </div>
            <div class="card-body p-0 m-0">
                <div class="row p-3">



                    <div class="col-md-6">
                        <div class="form-group">
                            <label for="firstname">Coupon Code Pertentage (1-99):</label>
                            <input type="text" class="form-control" id="CouponCodePertentage" maxlength="2" name="CouponCodePertentage" required>
                        </div>
                    </div>
                    <div class="form_group">
                        <label>Select User</label>
                        <select class="form-control" id="UserId">
                        </select>
                    </div>



                </div>


                <div class="row">
                    <div class="col-md-6">

                        <button type="button" class="btn btn-success m-3" id="save">Generate</button>
                    </div>
                </div>

            </div>
        </div>
    </div>


</section>



@section Scripts {

    <script src="~/dashboard/Coupons.js"></script>
}