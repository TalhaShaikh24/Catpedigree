
<link href="https://cdnjs.cloudflare.com/ajax/libs/magnific-popup.js/1.1.0/magnific-popup.min.css" rel="stylesheet" />

<script src="https://cdnjs.cloudflare.com/ajax/libs/magnific-popup.js/1.1.0/jquery.magnific-popup.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/watermarkjs/dist/watermark.min.js"></script>

<style>

    .thumb {
        margin-bottom: 15px;
    }

        .thumb:last-child {
            margin-bottom: 0;
        }

        .thumb img {
            -webkit-filter: grayscale(100%);
            filter: grayscale(100%);
            transition: filter 0.5s ease;
        }
       /*  .thumb
        figure img {
            -webkit-filter: grayscale(100%);
            filter: grayscale(100%);
            -webkit-transition: .3s ease-in-out;
            transition: .3s ease-in-out;
        }

        .thumb
        figure:hover img {
            -webkit-filter: grayscale(0);
            filter: grayscale(0);
        } */

    .Watermarkbutton {
        position: absolute;
        bottom: 25px;
        right: 15px;
        display: none;
        opacity: 0.6;
        transition: 0.3s;
    }

    .thumb:hover > .Watermarkbutton {
        display: block;
        opacity: 1
    }

    .img-thumbnail {
        max-width: 100% !important;
        height: 320px;
        object-fit: cover;
        width: 100% !important;
        min-width: 100% !important;
    }

    .CheckBoxSelection {
        position: absolute;
        right: 22px;
        z-index: 1;
        top: 10px;
    }

    input[type="checkbox"] {
        transform: scale(2);
    }

    .SelectAll {
        display: flex;
        align-items: center;
    }

    .preloader {
        display: none !important;
    }
</style>

<section class="container-fluid">

   


    <div class="row gallery">
    </div>
</section>


<div class="modal fade" id="WaterMarkModal">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <div class="modal-body">
                <div class="row">

                    <div class="col-lg-6 col-md-4 col-xs-6 border p-4 rounded shadow-sm" id="apppendImage">
                    </div>

                    <div class="col-lg-6 col-md-4 col-xs-6 thumb">

                        <form id="watermarkForm" class="border p-4 rounded shadow-sm">
                            <h4 class="mb-4">Watermark Settings</h4>

                            <div class="form-group">
                                <label for="UploadWaterMark">Upload Watermark:</label>
                                <input type="file" class="form-control-file" id="UploadWaterMark">
                            </div>

                            <div class="form-group">
                                <label for="position">Position:</label>
                                <select class="form-control" id="position" name="position">
                                    <option value="top-left">Top Left</option>
                                    <option value="top-center">Top Center</option>
                                    <option value="top-right">Top Right</option>
                                    <option value="center-left">Center Left</option>
                                    <option value="center">Center</option>
                                    <option value="center-right">Center Right</option>
                                    <option value="bottom-left">Bottom Left</option>
                                    <option value="bottom-center">Bottom Center</option>
                                    <option value="bottom-right">Bottom Right</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="offsetX">Offset X:</label>
                                <input type="number" class="form-control" id="offsetX" name="offsetX" value="10">
                            </div>

                            <div class="form-group">
                                <label for="offsetY">Offset Y:</label>
                                <input type="number" class="form-control" id="offsetY" name="offsetY" value="10">
                            </div>

                            <div class="form-group">
                                <label for="watermarkWidth">Width:</label>
                                <input type="number" class="form-control" id="watermarkWidth" name="watermarkWidth" value="300">
                            </div>

                            <div class="form-group">
                                <label for="watermarkOpacity">Opacity (0-1):</label>
                                <input type="number" class="form-control" id="watermarkOpacity" name="watermarkOpacity" step="0.1" min="0" max="1" value="0.5">
                            </div>
                        </form>


                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="replaceImage">Save</button>
                <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>



@section Scripts {

    <script src="~/dashboard/BreederLicense.js"></script>
}


