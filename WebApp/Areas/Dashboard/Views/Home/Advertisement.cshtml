


<section class="content pb-4 pt-4">
    <div class="container-fluid">

        <div class="card card-primary p-0 m-0">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><b>Advertisement Packages</b></h3>

            </div>
            <div class="card-body p-0 m-0">
                <div class="row p-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Image</label>

                            <input type="file" class="form-control" id="file" />
                      

                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Advertisement Packages</label>
                            <select class="form-control" id="AdvertisementPackages">
                            </select>

                        </div>
                    </div>



                </div>


                <div class="row">
                    <div class="col-md-6">

                        <button type="button" class="btn btn-success m-3" id="save">save</button>
                    </div>
                </div>

            </div>
        </div>
    </div>



    <div class="container-fluid">

        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><b>Listings</b></h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>

                </div>
            </div>
            <div class="card-body">
                <table id="TableApprovalListing" class="table table-bordered table-responsive" style="width:100%;">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Title</th>
                            <th>Cost</th>
                            <th>Type</th>
                            <th>No. Of Advertisement</th>

                            <th>Status</th>
                            <th>Created On</th>
                            <th>Image</th>
                            
                        </tr>
                    </thead>
                    <tbody id="AppendApprovalListing">
                    </tbody>
                </table>
            </div>
        </div>


    </div>
</section>



@section Scripts {

    <script src="~/dashboard/AdvertisementpackagesUserSelecting.js"></script>
}