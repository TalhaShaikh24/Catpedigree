

@{
    ViewData["Title"] = "Advertisementpackages";
    Layout = "~/Areas/Dashboard/Views/Shared/_Layout.cshtml";
}
<style>
    .pricing-table-slider {
        margin-left: -15px;
        margin-right: -15px;
    }

    .pricing-table {
        border: 1px solid #ddd;
        padding: 0 10px;
        position: relative;
        transition: all .3s linear;
        height: 100%;
        min-height: 260px;
    }

        .pricing-table h3 {
            color: rgba(255, 122, 89, 1.0) !important;
            font-size: 2.5em;
            margin: 20px 0;
            text-align: center;
        }

        .pricing-table .price {
            font-size: 3em;
            color: black;
            line-height: 1.5em;
            margin: 0;
            text-align: center;
        }

            .pricing-table .price span {
                font-size: .5em !important;
            }

        .pricing-table ul.list-features {
            list-style: none;
            padding-left: 20px;
            margin: 30px 0 70px;
        }

            .pricing-table ul.list-features li {
                border-bottom: 1px solid #ddd;
                font-size: 1.2em;
                color: black !important;
                margin: 0 20px 10px;
                padding-bottom: 10px;
                position: relative;
            }

                .pricing-table ul.list-features li span.green {
                    fill: green;
                }

                .pricing-table ul.list-features li span {
                    border-radius: 100%;
                    content: "";
                    height: 20px;
                    left: -15px;
                    position: absolute;
                    width: 20px;
                }

        .pricing-table .button-pt {
            background-color: #ff344f;
            color: #fff;
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            font-size: 1.5em;
            height: 50px;
            -webkit-box-align: center;
            -ms-flex-align: center;
            align-items: center;
            -webkit-box-pack: center;
            -ms-flex-pack: center;
            bottom: 0;
            justify-content: center;
            left: 0;
            margin: 0;
            position: absolute;
            width: 100%;
        }
</style>


<!--====== SweetAlert css ======-->
<link rel="stylesheet" href="~/webassets/css/sweetalert2.css">

