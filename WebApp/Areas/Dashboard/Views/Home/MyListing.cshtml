
<section class="content pb-4 pt-4">
    <div class="container-fluid">

        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><b>Filters</b></h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>

                </div>
            </div>
            <div class="card-body">
                <div class="row filter-container">
                    <div class="col-md-3">
                        <label for="filterStatus">Status:</label>
                        <select id="filterStatus" class="form-control">
                            <option value="">All</option>
                            <option value="Approved">Approved</option>
                            <option value="Rejected">Rejected</option>
                            <option value="Pending">Pending</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="filterCatType">Breed:</label>
                        <select id="filterCatType" class="form-control">
                            <option value="">All</option>
                            <!-- Add options dynamically based on data -->
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="filterCategoryName">Category:</label>
                        <select id="filterCategoryName" class="form-control">
                            <option value="">All</option>
                            <!-- Add options dynamically based on data -->
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="filterPackageName">Package:</label>
                        <select id="filterPackageName" class="form-control">
                            <option value="">All</option>
                            <!-- Add options dynamically based on data -->
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title"><b>My Listings</b></h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>

                </div>
            </div>
            <div class="card-body table-responsive">
                <table id="TableMyListings" class="table table-bordered ">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Status</th>
                            <th>Title</th>
                            <th>Email</th>
                            <th>Breed</th>
                            <th>Category</th>
                            <th>Package</th> 
                            <th>Promotion</th>
                            <th>IsActive</th>
                            <th>CreatedOn</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody id="AppendMyListings">
                        
                    </tbody>
                </table>
            </div>
        </div>


    </div>


</section>

<div class="modal" id="UpdateListingModal">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">

            <!-- Modal Header -->
            <div class="modal-header">
                <h4 class="modal-title"><b>Update Listing</b></h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>

            <!-- Modal body -->
            <div class="modal-body">
              

                <div class="d-flex mb-4">
                    <div id="status_reason"> </div>
                </div>
         
                    

              
                            <input type="hidden" id="HDID" />
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form_group">
                                        <label>Pakages</label>
                                        <select class="form-control" id="PackageId">
                                        </select>
                                    </div>

                                </div>
                                <div class="col-md-6">
                                    <div class="form_group">
                                        <label>Category</label>
                                        <select class="form-control" id="Category">
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row pt-4">
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label for="title">Title</label>
                                        <input type="text" class="form-control" id="Title" name="Title">
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form_group">
                                        <label>Gender</label>
                                        <select class="form-control" id="Gender">
                                            <option value="Male">Male</option>
                                            <option value="Female">Female</option>

                                        </select>
                                    </div>
                                </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label for="title">Cattery Name</label>
                            <input type="text" class="form-control" id="CatteryName" name="CatteryName">
                        </div>
                    </div>
                            </div>
                            <div class="row pt-4">

                                <div class="col-lg-4">
                                    <div class="form_group">
                                        <label>TYPE OF CAT</label>
                            <select class="form-control" id="TypeOfCat">
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form_group">
                                        <label>AGE</label>

                            <select class="form-control" id="Age">
                                            <option value="-1" disabled selected>Select Age</option>
                                <option value="1 Months">1 Month</option>
                                <option value="2 Months">2 Months</option>
                                <option value="3 Months">3 Months</option>
                                <option value="4 Months">4 Months</option>
                                <option value="5 Months">5 Months</option>
                                <option value="6 Months">6 Months</option>
                                <option value="7 Months">7 Months</option>
                                <option value="8 Months">8 Months</option>
                                <option value="9 Months">9 Months</option>
                                <option value="10 Months">10 Months</option>
                                <option value="11 Months">11 Months</option>
                                <option value="1 Year">1 Year</option>
                                <option value="2 Years">2 Years</option>
                                <option value="3 Years">3 Years</option>
                                <option value="4 Years">4 Years</option>
                                <option value="5 Years">5 Years</option>
                                <option value="6 Years">6 Years</option>
                                <option value="7 Years">7 Years</option>
                                <option value="8 Years">8 Years</option>
                                <option value="9 Years">9 Years</option>
                                <option value="10 Years">10 Years</option>
                                <option value="11 Years">11 Years</option>
                                <option value="12 Years">12 Years</option>
                                <option value="13 Years">13 Years</option>
                                <option value="14 Years">14 Years</option>
                                <option value="15 Years">15 Years</option>
                                <option value="16 Years">16 Years</option>
                                <option value="17 Years">17 Years</option>
                                <option value="18 Years">18 Years</option>
                                <option value="19 Years">19 Years</option>
                                <option value="20 Years">20 Years</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-lg-4">
                                    <div class="form_group">
                                        <label>Price</label>
                                        <div class="form_group">
                                <input type="text" class="form-control" id="Price" placeholder="Price" name="name"  >
                                        </div>
                                    </div>
                                </div>
                    <div class="col-lg-4 mt-3">
                        <div class="form_group">
                            <label>(Family tree) Name Mother</label>
                            <div class="form_group">
                                <input type="text" class="form-control" id="FTMother" placeholder="Mother's Name" name="FTMother">
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 mt-3">
                        <div class="form_group">
                            <label>(Family tree) Name Father</label>
                            <div class="form_group">
                                <input type="text" class="form-control" id="FTFather" placeholder="Father's Name" name="FTFather">
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 mt-3">
                        <div class="form_group">
                            <label>Mother has been tested for</label>
                            <div class="form_group">
                                <input type="text" class="form-control" id="MotherTested" placeholder="Test Details" name="MotherTested">
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 mt-3">
                        <div class="form_group">
                            <label>Father has been tested for</label>
                            <div class="form_group">
                                <input type="text" class="form-control" id="FatherTested" placeholder="Test Details" name="FatherTested">
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 mt-3">
                        <div class="form_group">
                            <label>Date Of Birth</label>
                            <div class="form_group">
                                <input type="date" class="form-control" id="DataOFBirth" name="DataOFBirth">
                            </div>
                        </div>
                    </div>



                                <div class="col-lg-6 mt-3" style="display:none">
                                    <div class="form_group">
                                        <label>Weigth</label>
                                        <div class="form_group">
                                        <input type="text" class="form-control" id="Weigth" placeholder="Weigth" name="name">
                                        </div>
                                    </div>
                                </div>

                    <div class="col-lg-6 mt-3" style="display:none">
                                    <div class="form_group">
                                        <label>Color</label>
                                        <div class="form_group">
                                     <input type="text" class="form-control" id="Color" placeholder="Color" name="name" >
                                        </div>
                                    </div>
                                </div>


                    <div class="col-lg-6 mt-3" style="display:none">
                                    <div class="form_group">
                                        <label class="d-block">Vaccination</label>
                                        <div class="form_group my-3" style="display: flex;align-items: baseline;">
                                            <div class="single-checkbox d-flex mr-4">
                                                <input type="radio" id="Yes" name="IsVaccinated" value="1" checked>
                                                <label for="Yes"><span>Yes</span></label>
                                            </div>
                                            <div class="single-checkbox d-flex mr-4">
                                                <input type="radio" id="No" name="IsVaccinated" value="0">
                                                <label for="No"><span>No</span></label>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                    <div class="col-lg-6 mt-3">
                        <div class="form_group">
                            <label class="d-block">Sterilization</label>
                            <div class="form-group" style="display: flex; align-items: baseline;">
                                <div class="icheck-primary d-inline mr-4">
                                    <input type="radio" id="IsSterilizationYes" name="IsSterilization" value="1">
                                    <label for="IsSterilizationYes">Yes</label>
                                </div>
                                <div class="icheck-primary d-inline mr-4">
                                    <input type="radio" id="IsSterilizationNo" name="IsSterilization" value="0">
                                    <label for="IsSterilizationNo">No</label>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="col-lg-6 mt-3">
                        <div class="form_group">
                            <label class="d-block">Castration</label>
                            <div class="form-group" style="display: flex; align-items: baseline;">
                                <div class="icheck-primary d-inline mr-4">
                                    <input type="radio" id="IsCastrationYes" name="IsCastration" value="1">
                                    <label for="IsCastrationYes">Yes</label>
                                </div>
                                <div class="icheck-primary d-inline mr-4">
                                    <input type="radio" id="IsCastrationNo" name="IsCastration" value="0">
                                    <label for="IsCastrationNo">No</label>
                                </div>
                            </div>
                        </div>
                    </div>

                            </div>
                            <div class="row pt-3">
                                <div class="col-md-12">
                                    <div class="form_group">
                                        <label class="d-block">DESCRIPTION</label>
                                        <textarea class="form-control" id="Description" rows="5"></textarea>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-4" id="PEDIGREE" style="display:none;">
                                <h4 class="title">PEDIGREE</h4>
                                <p>Click here or drop files to upload</p>

                                <div class="row my-2" id="PedigreeImageViewAppend"></div>
                                       
                            </div>


                            @*  Gallery Work *@
                            <h4 class="title pt-4">Gallery Images</h4>
                            <p>Click here or drop files to upload</p>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form_group file-input-two">
                                        <div class="form_group">
                                            <label class="d-block" style="line-height: 20px; font-weight:900">Featured Image</label>

                                            <div class="form_group">
                                                <input type="file" id="FeaturedFile" class="form_control bg-white pt-4" required style="opacity:1!important">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row my-2" id="FeaturedImageAppend">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form_group file-input-two">
                                        <div class="form_group">
                                            <label class="d-block" style="line-height: 20px; font-weight:900">GALLERY (OPTIONAL)</label>

                                            <div class="form_group">
                                                <input type="file" multiple id="Gallery_Files" class="form_control bg-white pt-4" required style="opacity:1!important">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row" id="GalleryFilesAppend">
                                    </div>
                                </div>
                            </div>

                            @* Video Work *@
                            <div class="row" style="display:none">
                                <div class="col-md-8">

                        <h4 class="title pt-4">Video</h4>
                        <p>Click here or drop files to upload</p>
                                    <div class="form_group file-input-two">
                                        <div class="form_group">
                                            <label class="d-block" style="line-height: 5px;">VIDEO POST (OPTIONAL)</label>
                                            <small> Post video of your beloved kittens</small>
                                            <div class="form_group">
                                                <input type="file" id="VideoFile" class="form_control bg-white pt-4" required style="opacity:1!important">

                                            </div>
                                        </div>

                                        <div class="row my-2" id="VideoFileAppend">
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @* Details Information *@
                            <h4 class="title pt-4">Detailed Information</h4>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Location">Location</label>
                                        <input type="text" class="form-control" id="Location" placeholder="Location">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="State">State</label>
                                        <input type="text" class="form-control" id="State" placeholder="State">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="City">City</label>
                                        <input type="text" class="form-control" id="City" placeholder="City">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="PHONE" class="d-block">Phone (Optional)</label>
                                        <input type="tel" class="form-control" id="Phone" autofocus>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="Email">Email</label>
                                        <input type="text" class="form-control" id="Email" placeholder="Email">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="BREEDER">BREEDER'S NAME</label>
                                        <input type="tel" class="form-control" id="BreerderName" placeholder="BREEDER'S NAME">
                                    </div>
                                </div>
                            </div>
                            <div class="row pt-4">
                                <div class="col-md-6">
                                    <div class="form_group">
                                        <label class="d-block" style="line-height: 5px; font-weight:600">BREEDER'S LICENSE</label>
                                        <small>We need your Breeder's License to verify that you are an authorized person.</small>
                                        <small>No listing will be posted until we have and review all documentation.</small>
                                        <small>Please upload your license to your profile. This is your profile page: My Profile</small>
                                        <small>Please check our Terms and Conditions page for further information.</small>
                                        
                                        <div class="form-group clearfix mt-3 mb-4">
                                            <div class="icheck-primary mb-2">
                                                <input type="radio" id="check2" name="IsBreerderLicenseUpload" value="false" checked>
                                                <label for="check2">I will upload my license to my profile.</label>
                                            </div>
                                            <div class="icheck-primary mb-2">
                                                <input type="radio" id="check3" name="IsBreerderLicenseUpload" value="true">
                                                <label for="check3">I've already uploaded my license to my profile.</label>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form_group">
                                        <label class="d-block" style="line-height: 30px; font-weight:900">ZOOLOGICAL NUMBER (OPTIONAL)</label>
                                        <label class="d-block mb-3" style="line-height: 5px; font-size:12px; font-style:italic; font-weight:900">VENDORS FROM SPAIN ONLY</label>
                                        <small>If you're selling from spain, we need your zoological number, to verify that you are an authorized vendor.</small>
                                        <small>No listing will be posted until we have, and review all documentation.</small>
                                        <small>Please upload your license to your profile. This is your profile page: My Profile</small>
                                        <small>Please check our Terms and Conditions page for further information.</small>
                                        
                                        <div class="form-group mt-2">
                                            <div class="icheck-primary d-inline">
                                                <input type="checkbox" id="ZoologicalNumber" name="hereby" value="true" checked disabled>
                                                <label for="ZoologicalNumber">Hereby I confirm that I've added my zoological number to my profile.</label>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>

                           
                       

                
            </div>

            <!-- Modal footer -->
            <div class="modal-footer">
                <button class="btn btn-success" type="button" id="Btn_Update_Listing">Update</button>
                <button type="button" class="btn btn-danger" data-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    <script src="~/dashboard/MyListing.js"></script>
