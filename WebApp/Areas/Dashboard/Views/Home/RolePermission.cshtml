@{
    ViewData["Breadcrumb"] = "Role and Permission";
}


<style>
    .dropdown-left .dropdown-menu {
        left: 2px !important;
        right: 0px !important;
    }

</style>

<div class="row">

    <div class="col-md-6 mb-3">

        <div class="card card-primary p-0 m-0">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><b>Create Role</b></h3>
                <button class="btn btn-success" id="Btn_CreateRoleSubmit" style="margin-left: auto;">Create Role</button>
            </div>
            <div class="card-body p-0 m-0">
                <div class="row p-3">

                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Role Name</label>
                            <input type="text" class="form-control" id="textRole" placeholder="Enter Role Name">
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">

        <div class="card card-primary p-0 m-0">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><b>Create Screen Permission</b></h3>
                <button class="btn btn-success" id="Btn_RoleScreenPermissionSubmit" style="margin-left: auto;">Create Permission</button>
            </div>
            <div class="card-body p-0 m-0">
                <div class="row p-3">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Select Role</label>
                            <select class="form-control selectpicker" id="ddlRoles" title="Select Role"  data-live-search="true" data-size="10">
                            </select>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Select Screens </label>
                            <select class="form-control selectpicker dropdown-left" multiple id="ddlScreens" title="Select Screens" data-live-search="true" data-size="10" data-actions-box="true">
                            </select>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    </div>


 </div>
 
 <div class="row">

    <div class="col-md-6 mb-3">

        <div class="card card-primary p-0 m-0 mt-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><b>Roles</b></h3>
            </div>
            <div class="card-body p-3">

                <table id="RoleTable" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Role Id</th>
                            <th>Role Name</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>


            </div>
        </div>

    </div>

    <div class="col-md-6 mb-3">

        <div class="card card-primary p-0 m-0 mt-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h3 class="card-title"><b>Permission Details</b></h3>
            </div>
            <div class="card-body p-3">

                <table id="permissionsTable" class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Role</th>
                            <th>Screens</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>


            </div>
        </div>

    </div>


 </div>







@section Scripts {

    <script src="~/dashboard/RolePermission.js"></script>
}
